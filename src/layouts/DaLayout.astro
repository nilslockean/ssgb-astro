---
import Layout, { type Props } from "./Layout.astro";
import badgeEn from "../assets/images/forbundet-en.png";
import { Image } from "astro:assets";

const { ...rest } = Astro.props;
---

<Layout {...rest}>
  <Image
    width={320}
    src={badgeEn}
    alt="Brug altid en autoriseret instruktør."
    slot="sidebar-bottom"
    style="height: auto"
  />
  <slot />
</Layout>
