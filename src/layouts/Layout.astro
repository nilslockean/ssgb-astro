---
import "../styles/global.css";
import "@fancyapps/ui/dist/fancybox/fancybox.css";
import CourseNav from "../components/CourseNav.astro";
import SiteLogo from "../components/SiteLogo.astro";
import PostHog from "../components/posthog.astro";
import WeGlot from "../components/weglot.astro";
// Host Grotesk supports weights 300-800
import "@fontsource-variable/host-grotesk";
import "@fontsource/instrument-serif";
import "@fontsource/cooper-hewitt/700.css";
import ButtonGroup from "@components/ButtonGroup.astro";
import ButtonLink from "@components/ButtonLink.astro";
import MobileHeader from "@components/MobileHeader.astro";
import NavLink from "@components/NavLink.astro";
import config, { NavArea } from "@config";
import {
  ENABLE_POSTHOG,
  POSTHOG_PROJECT_API_KEY,
  ENABLE_WEGLOT,
  WEGLOT_API_KEY,
} from "astro:env/server";
import Fienta from "@components/fienta.astro";

interface Props {
  metaDescription: string;
  metaTitle?: string;
  tagline?: string;
  fientaEmbed?: boolean;
}
const { metaDescription, tagline, metaTitle, fientaEmbed } = Astro.props;
const url = Astro.url.toString();
const title = metaTitle
  ? `${metaTitle} • ${config.siteTitle}`
  : `${config.siteTitle} • ${tagline || config.siteTagline}`;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <meta content={Astro.generator} name="generator" />
    <!-- HTML Meta Tags -->
    <title set:html={title} />
    <meta content={metaDescription} name="description" />

    <!-- Facebook Meta Tags -->
    <meta content={url} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={metaDescription} property="og:description" />
    <meta content="/og-default.png" property="og:image" />

    <!-- Twitter Meta Tags -->
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="dubbel8.se" property="twitter:domain" />
    <meta content={url} property="twitter:url" />
    <meta content={title} name="twitter:title" />
    <meta content={metaDescription} name="twitter:description" />
    <meta content="/og-default.png" name="twitter:image" />

    {ENABLE_POSTHOG && <PostHog projectApiKey={POSTHOG_PROJECT_API_KEY} />}
    {ENABLE_WEGLOT && <WeGlot apiKey={WEGLOT_API_KEY} />}
    {
      fientaEmbed && (
        <Fienta
          options={{
            border_radius: "12px",
            background: "rgba(0,0,0,0.5)",
            descriptionEnabled: true,
            step: "description",
          }}
        />
      )
    }

    <slot name="head" />
  </head>
  <body class="bg-brand text-muted">
    <!-- Mobile navigation -->
    <MobileHeader links={config.navigation[NavArea.MOBILE]} />
    <!-- Content and desktop nav -->
    <div class="flex flex-nowrap">
      <aside
        class="bg-brand border-line sticky top-0 hidden h-dvh grow-0 basis-64 flex-col justify-between gap-16 overflow-y-auto border-r p-8 md:flex"
      >
        <div class="flex flex-col gap-8">
          <SiteLogo height={80} />
          <!-- kurser -->
          <CourseNav entries={config.navigation[NavArea.SIDEBAR_COURSE]} />
        </div>
        <nav class="flex flex-col gap-2">
          {
            config.navigation[NavArea.SIDEBAR_ASIDE].map((item) => (
              <NavLink href={item.link.path}>{item.link.label}</NavLink>
            ))
          }
        </nav>
      </aside>
      <div class="flex-1">
        <header
          class="bg-brand border-line hidden items-baseline justify-between gap-4 border-b p-8 py-6 md:flex"
        >
          <p class="text-accent shrink">{tagline || config.siteTagline}</p>
          <!-- Action buttons -->
          <ButtonGroup class="flex-1 justify-end">
            {
              config.navigation[NavArea.HEADER].map((item) => (
                <ButtonLink
                  class="text-xs whitespace-nowrap"
                  href={item.link.path}
                >
                  {item.link.label}
                </ButtonLink>
              ))
            }
          </ButtonGroup>
        </header>
        <main>
          <slot />
        </main>
        <footer
          class="bg-brand border-line flex flex-wrap justify-between gap-6 border-t px-6 py-4"
        >
          <nav class="flex basis-full flex-col gap-2 py-6 md:hidden">
            {
              config.navigation[NavArea.SIDEBAR_ASIDE].map((item) => (
                <NavLink href={item.link.path}>{item.link.label}</NavLink>
              ))
            }
          </nav>
          <p class="font-bold">
            &copy; {new Date().getFullYear()}&nbsp;{config.siteTitle}
          </p>
          <nav class="flex gap-3">
            {
              config.navigation[NavArea.FOOTER].map((item) => (
                <NavLink class="text-sm" href={item.link.path}>
                  {item.link.label}
                </NavLink>
              ))
            }
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>
