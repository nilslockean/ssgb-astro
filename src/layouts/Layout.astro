---
import "../styles/global.css";
import CourseNav from "../components/CourseNav.astro";
import SiteLogo from "../components/SiteLogo.astro";
import PostHog from "../components/posthog.astro";
import WeGlot from "../components/weglot.astro";
import ButtonGroup from "@components/ButtonGroup.astro";
import ButtonLink from "@components/ButtonLink.astro";
import MobileHeader from "@components/MobileHeader.astro";
import NavLink from "@components/NavLink.astro";
import config, { NavArea } from "@config";
import {ENABLE_POSTHOG, POSTHOG_PROJECT_API_KEY} from "astro:env/client";
import Fienta from "@components/fienta.astro";

interface Props {
  metaDescription: string;
  metaTitle?: string;
  tagline?: string;
  fientaEmbed?: boolean;
}
const { metaDescription, tagline, metaTitle, fientaEmbed } = Astro.props;
const url = Astro.url.toString();
const title = metaTitle
  ? `${metaTitle} • ${config.siteTitle}`
  : `${config.siteTitle} • ${tagline || config.siteTagline}`;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <meta content={Astro.generator} name="generator" />
    <title set:html={title} />
    <meta content={metaDescription} name="description" />

    <meta content={url} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={metaDescription} property="og:description" />
    <meta content="/og-default.png" property="og:image" />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content="dubbel8.se" property="twitter:domain" />
    <meta content={url} property="twitter:url" />
    <meta content={title} name="twitter:title" />
    <meta content={metaDescription} name="twitter:description" />
    <meta content="/og-default.png" name="twitter:image" />

    {ENABLE_POSTHOG && <PostHog projectApiKey={POSTHOG_PROJECT_API_KEY} />}
    {
      fientaEmbed && (
        <Fienta
          options={{
            border_radius: "12px",
            background: "rgba(0,0,0,0.5)",
            descriptionEnabled: true,
            step: "description",
          }}
        />
      )
    }

    <slot name="head" />
  </head>
  <body class="layout">
    <MobileHeader links={config.navigation[NavArea.MOBILE]} />
    <div class="layout__wrapper">
      <aside class="layout__sidebar">
        <div class="layout__sidebar-top">
          <SiteLogo height={80} />
          <CourseNav entries={config.navigation[NavArea.SIDEBAR_COURSE]} />
        </div>
        <nav class="layout__sidebar-nav">
          {
            config.navigation[NavArea.SIDEBAR_ASIDE].map((item) => (
              <NavLink href={item.link.path}>{item.link.label}</NavLink>
            ))
          }
        </nav>
      </aside>
      <div class="layout__main">
        <header class="layout__header">
          <p class="layout__tagline">{tagline || config.siteTagline}</p>
          <ButtonGroup class="layout__header-actions">
            {
              config.navigation[NavArea.HEADER].map((item) => (
                <ButtonLink
                  class="text-xs whitespace-nowrap"
                  href={item.link.path}
                >
                  {item.link.label}
                </ButtonLink>
              ))
            }
          </ButtonGroup>
        </header>
        <main>
          <slot />
        </main>
        <footer class="layout__footer">
          <nav class="layout__footer-nav-mobile">
            {
              config.navigation[NavArea.SIDEBAR_ASIDE].map((item) => (
                <NavLink href={item.link.path}>{item.link.label}</NavLink>
              ))
            }
          </nav>
          <p class="layout__copyright">
            &copy; {new Date().getFullYear()}&nbsp;{config.siteTitle}
          </p>
          <nav class="layout__footer-nav">
            {
              config.navigation[NavArea.FOOTER].map((item) => (
                <NavLink class="text-sm" href={item.link.path}>
                  {item.link.label}
                </NavLink>
              ))
            }
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .layout {
    background-color: var(--color-surface);
    color: var(--color-muted);
  }

  .layout__wrapper {
    display: flex;
    flex-wrap: nowrap;
  }

  .layout__sidebar {
    background-color: var(--color-surface);
    border-right: 1px solid var(--color-line);
    position: sticky;
    top: 0;
    height: 100dvh;
    flex-grow: 0;
    flex-shrink: 0;
    width: 16rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-16);
    overflow-y: auto;
    padding: var(--space-8);
  }

  @media (max-width: 47.99rem) {
    .layout__sidebar {
      display: none;
    }
  }

  @media (--breakpoint-md) {
    .layout__sidebar {
      display: flex;
    }
  }

  .layout__sidebar-top {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .layout__sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .layout__main {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .layout__header {
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-6) var(--space-8);
    display: none;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  @media (--breakpoint-md) {
    .layout__header {
      display: flex;
    }
  }

  .layout__tagline {
    color: var(--color-accent);
    flex-shrink: 1;
  }

  .layout__header-actions {
    flex: 1;
    justify-content: flex-end;
  }

  .layout__footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-line);
    padding: var(--space-4) var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .layout__footer-nav-mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex-basis: 100%;
    padding-block: var(--space-6);
  }

  @media (--breakpoint-md) {
    .layout__footer-nav-mobile {
      display: none;
    }
  }

  .layout__copyright {
    font-weight: var(--font-weight-bold);
  }

  .layout__footer-nav {
    display: flex;
    gap: var(--space-3);
  }
</style>
