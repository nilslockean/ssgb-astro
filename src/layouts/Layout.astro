---
import "../styles/global.css";
import SiteLogo from "@features/navigation/SiteLogo.astro";
import SidebarNav from "@features/navigation/SidebarNav.astro";
import ButtonGroup from "@components/ButtonGroup.astro";
import LanguagePicker from "@features/locale/LanguagePicker.astro";
import LanguageList from "@features/locale/LanguageList.astro";
import MobileHeader from "@components/MobileHeader.astro";
import NavLink from "@components/NavLink.astro";
import AuthorizedInstructorBanner from "@features/banners/AuthorizedInstructorBanner.astro";
import PostHog from "@features/third-party/posthog.astro";
import { ENABLE_POSTHOG, POSTHOG_PROJECT_API_KEY } from "astro:env/client";
import { Font } from "astro:assets";
import { Seo } from "@datocms/astro/Seo";
import { getLocalizedConfig, getLocalizedUrls } from "@lib/contentUtils.ts";
import type { DatoSeoTag } from "../schemas/dato.ts";
import { localeSchema } from "../schemas/locale";

const locale = localeSchema.parse(Astro.currentLocale);
const config = await getLocalizedConfig(locale);

export interface Props {
  metaDescription: string;
  metaTitle?: string;
  tagline?: string;
  seoData?: DatoSeoTag[];
}
const { metaDescription, tagline, metaTitle, seoData } = Astro.props;
const url = Astro.url.toString();
const title = metaTitle
  ? `${metaTitle} • ${config.siteTitle}`
  : `${config.siteTitle} • ${tagline || config.siteTagline}`;

const faviconData = config.faviconMetaTags ?? [];
const allSeoData = seoData ? [...seoData, ...faviconData] : undefined;

let localizedUrls: Record<string, string> | null = null;
try {
  localizedUrls = await getLocalizedUrls(Astro.url);
} catch {
  // not available for error pages or unmatched routes
}
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <meta content={Astro.generator} name="generator" />

    {
      allSeoData ? (
        <Seo data={allSeoData} />
      ) : (
        <>
          <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
          <title set:html={title} />
          <meta content={metaDescription} name="description" />
          <meta content={url} property="og:url" />
          <meta content="website" property="og:type" />
          <meta content={title} property="og:title" />
          <meta content={metaDescription} property="og:description" />
          <meta content="summary_large_image" name="twitter:card" />
          <meta content={url} property="twitter:url" />
          <meta content={title} name="twitter:title" />
          <meta content={metaDescription} name="twitter:description" />
        </>
      )
    }

    <link href={url} rel="canonical" />
    {
      localizedUrls && (
        <>
          {Object.entries(localizedUrls).map(([locale, href]) => (
            <link href={href} rel="alternate" hreflang={locale} />
          ))}
          <link href={localizedUrls.sv} rel="alternate" hreflang="x-default" />
        </>
      )
    }

    <Font cssVariable="--font-barlow-condensed" preload />
    <Font cssVariable="--font-host-grotesk" preload />

    {ENABLE_POSTHOG && <PostHog projectApiKey={POSTHOG_PROJECT_API_KEY} />}

    <slot name="head" />
  </head>
  <body class="layout">
    <MobileHeader links={config.navigation.primary} />
    <div class="layout__wrapper">
      <aside class="layout__sidebar">
        <div class="layout__sidebar-top">
          <SiteLogo height={80} />
        </div>
        <SidebarNav entries={config.navigation.primary} />
        <nav class="layout__sidebar-secondary-nav">
          {
            config.navigation.secondary.map((item) => (
              <NavLink href={item.link.path} small>
                {item.link.label}
              </NavLink>
            ))
          }
        </nav>
        <slot name="sidebar-bottom" />
      </aside>
      <div class="layout__main">
        <header class="layout__header">
          <p class="layout__tagline">
            {tagline || config.siteTagline}
          </p>
          <ButtonGroup class="layout__header-actions">
            <LanguagePicker />
          </ButtonGroup>
        </header>
        <main>
          <slot />
          <AuthorizedInstructorBanner />
        </main>
        <footer class="layout__footer">
          <div class="layout__footer-nav-mobile">
            <nav>
              {
                config.navigation.primary.map((item) => (
                  <NavLink href={item.link.path}>{item.link.label}</NavLink>
                ))
              }
            </nav>
            <LanguageList />
          </div>
          <p class="layout__copyright">
            &copy; {new Date().getFullYear()}&nbsp;{config.siteTitle}
          </p>
          <nav class="layout__footer-nav">
            {
              config.navigation.footer.map((item) => (
                <NavLink
                  target={item.link.newTab ? "_blank" : null}
                  href={item.link.path}
                  small
                >
                  {item.link.label}
                </NavLink>
              ))
            }
          </nav>
        </footer>
      </div>
    </div>
  </body>
</html>

<style>
  .layout__footer-nav-mobile :global(.lang-list) {
    margin-left: calc(var(--space-3) * -1);
  }

  .layout__sidebar-secondary-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
</style>
