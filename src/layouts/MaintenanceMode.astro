---
import "../styles/global.css";
import SiteLogo from "@features/navigation/SiteLogo.astro";
import PostHog from "@features/third-party/posthog.astro";
import { ENABLE_POSTHOG, POSTHOG_PROJECT_API_KEY } from "astro:env/client";
import { getLocalizedConfig } from "../lib/contentUtils";

interface Props {
  metaDescription: string;
  metaTitle?: string;
  tagline?: string;
}
const { metaDescription, tagline, metaTitle } = Astro.props;
const config = await getLocalizedConfig(Astro.currentLocale);
const url = Astro.url.toString();
const title = metaTitle
  ? `${metaTitle} • ${config.siteTitle}`
  : `${config.siteTitle} • ${tagline || config.siteTagline}`;
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width" name="viewport" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <meta content={Astro.generator} name="generator" />
    <title set:html={title} />
    <meta content={metaDescription} name="description" />

    <meta content={url} property="og:url" />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={metaDescription} property="og:description" />
    <meta content="/og-default.png" property="og:image" />

    <meta content="summary_large_image" name="twitter:card" />
    <meta content="dubbel8.se" property="twitter:domain" />
    <meta content={url} property="twitter:url" />
    <meta content={title} name="twitter:title" />
    <meta content={metaDescription} name="twitter:description" />
    <meta content="/og-default.png" name="twitter:image" />

    {ENABLE_POSTHOG && <PostHog projectApiKey={POSTHOG_PROJECT_API_KEY} />}
    <slot name="head" />
  </head>
  <body class="layout">
    <div class="maintenance-wrapper">
      <header>
        <SiteLogo displayText={false} height={80} />
      </header>
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  @import "../styles/breakpoints.css";

  .maintenance-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-8);
    padding-top: var(--space-16);
    background-color: var(--color-brand);
    color: var(--color-muted);
  }

  @media (--breakpoint-lg) {
    .maintenance-wrapper {
      padding-top: var(--space-36);
    }
  }
</style>
