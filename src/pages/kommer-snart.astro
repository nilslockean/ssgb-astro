---
import Link from "@components/Link.astro";
import PageHead from "@components/PageHead.astro";
import config, { siteConfig } from "@config";
import MaintenanceMode from "src/layouts/MaintenanceMode.astro";
---

<MaintenanceMode metaDescription={siteConfig.siteTagline}>
  <PageHead
    centered
    eyebrow="Välkommen till Dubbelåtta - ny hemsida under uppbyggnad"
    title={siteConfig.siteTagline}
  >
    <p>
      Kontakta oss på <Link href={`mailto:${config.contact.email}`}
        >{config.contact.email}</Link
      > för mer information.
    </p>
  </PageHead>
</MaintenanceMode>
