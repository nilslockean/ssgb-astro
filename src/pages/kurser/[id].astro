---
import { getCollection } from "astro:content";
import { StructuredText } from "@datocms/astro";
import Accordion from "@components/Accordion.astro";
import ButtonGroup from "@components/ButtonGroup.astro";
import ButtonLink from "@components/ButtonLink.astro";
import Hero, { type HeroButton } from "@components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import PageHead from "@components/PageHead.astro";
import BookingForm from "@features/forms/BookingForm.astro";
import FormSection from "@features/forms/FormSection.astro";
import PrivateBookingPricingList from "@features/pricing/PrivateBookingPricingList.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getEntry } from "astro:content";
import { defaultLocale, type Locale } from "@lib/routeUtils";

export async function getStaticPaths() {
  const posts = await getCollection(
    "courses",
    (course) => course.data.language === "sv" && course.data.hasPage,
  );
  return posts.map((post) => ({
    params: { id: post.data.slug },
    props: { post },
  }));
}

function composeNumDaysDesc(input: number[], locale = defaultLocale) {
  const suffixMap: Record<Locale, { one: string; many: string }> = {
    sv: { one: "dag", many: "dagar" },
    da: { one: "dag", many: "dage" },
    en: { one: "day", many: "days" },
  };
  const numDays = input.join("-");
  const numDaysSuffix =
    numDays === "1" ? suffixMap[locale].one : suffixMap[locale].many;
  return `${numDays} ${numDaysSuffix}`;
}

const {
  post: {
    data: {
      excerpt,
      title,
      heroImage,
      body,
      numDays,
      norm,
      prerequisites,
      minAge,
      maxParticipants,
      form,
      preselectedFields,
    },
  },
} = Astro.props;
const formEntry = form && (await getEntry("forms", form));
const h1 = norm?.title ?? title;
const cta = `Boka ${title.toLowerCase()}`;
const numDaysDesc = composeNumDaysDesc(numDays);
const heroButtons: HeroButton[] = [{ label: cta, href: "#boka" }];
if (norm?.url) {
  heroButtons.push({
    label: "Läs kursnormen",
    href: norm.url,
    target: "_blank",
  });
}
---

<Layout fientaEmbed metaDescription={excerpt} metaTitle={title}>
  {
    heroImage ? (
      <Hero
        buttons={heroButtons}
        content={excerpt}
        image={heroImage}
        title={h1}
      />
    ) : (
      <PageHead content={excerpt} title={h1}>
        <ButtonGroup slot="buttons">
          {heroButtons.map(({ href, label, target }, i) => (
            <ButtonLink
              {href}
              {target}
              variant={i == 0 ? "primary" : "default"}
            >
              {label}
            </ButtonLink>
          ))}
        </ButtonGroup>
      </PageHead>
    )
  }
  <Section>
    <div class="collection-entry">
      {body && <StructuredText data={body} />}
      <p>
        <strong>Tidsåtgång:</strong>
        {numDaysDesc}.
      </p>
    </div>
  </Section>

  <Section>
    {
      prerequisites && (
        <Accordion title="Förkunskapskrav">
          <div set:html={prerequisites} />
        </Accordion>
      )
    }
    {
      minAge !== null && (
        <Accordion title="Åldersgräns">
          <p>
            <strong>
              Lägsta ålder för att delta på kursen är {minAge} år.
            </strong>
            Minderåriga endast i målsmans sällskap.
          </p>
        </Accordion>
      )
    }
    {
      norm?.url && (
        <Accordion title="Kursnorm">
          <>
            <p>
              Denna kurs uppfyller{" "}
              <Link href={norm.url} target="_blank">
                Svenska Klätterförbundets norm för {norm.title}.
              </Link>
            </p>
            <p>
              Normerna säkerställer att kursen leds av instruktörer med rätt
              kompetens och att innehållet följer etablerade säkerhetskrav.
            </p>
          </>
        </Accordion>
      )
    }
    <Accordion title="Pris">
      <PrivateBookingPricingList class="mt-4" />
    </Accordion>
  </Section>
  {
    formEntry && (
      <FormSection form={formEntry} id="boka" title={cta} {preselectedFields} />
    )
  }
</Layout>

<style>
  @import "../../styles/breakpoints.css";

  .booking-card {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
  }

  @media (--breakpoint-md) {
    .booking-card {
      padding: var(--space-8) var(--space-12);
    }
  }
</style>
