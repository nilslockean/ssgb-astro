---
import { getCollection } from "astro:content";
import { StructuredText } from "@datocms/astro";
import Accordion from "@components/Accordion.astro";
import ButtonGroup from "@components/ButtonGroup.astro";
import ButtonLink from "@components/ButtonLink.astro";
import Hero, { type HeroButton } from "@components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import PageHead from "@components/PageHead.astro";
import BookingForm from "@features/forms/BookingForm.astro";
import PrivateBookingPricingList from "@features/pricing/PrivateBookingPricingList.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "courses",
    (course) => course.data.language === "sv",
  );
  return posts.map((post) => ({
    params: { id: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { norm } = post.data;
const h1 = norm?.title ?? post.data.title;
const cta = `Boka ${post.data.title.toLowerCase()}`;
const numDays = post.data.numDays.join("-");
const numDaysSuffix = numDays === "1" ? "dag" : "dagar";
const numDaysDesc = `${numDays} ${numDaysSuffix}`;
const heroButtons: HeroButton[] = [{ label: cta, href: "#boka" }];
if (norm?.url) {
  heroButtons.push({
    label: "Läs kursnormen",
    href: norm.url,
    target: "_blank",
  });
}
---

<Layout
  fientaEmbed
  metaDescription={post.data.excerpt}
  metaTitle={post.data.title}
>
  {
    post.data.heroImage ? (
      <Hero
        buttons={heroButtons}
        content={post.data.excerpt}
        image={post.data.heroImage}
        title={h1}
      />
    ) : (
      <PageHead content={post.data.excerpt} title={h1}>
        <ButtonGroup slot="buttons">
          {heroButtons.map(({ href, label, target }, i) => (
            <ButtonLink
              {href}
              {target}
              variant={i == 0 ? "primary" : "default"}
            >
              {label}
            </ButtonLink>
          ))}
        </ButtonGroup>
      </PageHead>
    )
  }
  <Section>
    <div class="collection-entry">
      {
        post.data.body && (
          <StructuredText data={post.data.body} />
        )
      }
      <p>
        <strong>Tidsåtgång:</strong>
        {numDaysDesc}.
      </p>
    </div>
  </Section>

  <Section>
    {
      post.data.prerequisites && (
        <Accordion title="Förkunskapskrav">
          <div set:html={post.data.prerequisites} />
        </Accordion>
      )
    }
    {
      post.data.minAge !== null && (
        <Accordion title="Åldersgräns">
          <p>
            <strong>
              Lägsta ålder för att delta på kursen är {post.data.minAge} år.
            </strong>
            Minderåriga endast i målsmans sällskap.
          </p>
        </Accordion>
      )
    }
    {
      norm?.url && (
        <Accordion title="Kursnorm">
          <>
            <p>
              Denna kurs uppfyller{" "}
              <Link href={norm.url} target="_blank">
                Svenska Klätterförbundets norm för {norm.title}.
              </Link>
            </p>
            <p>
              Normerna säkerställer att kursen leds av instruktörer med rätt
              kompetens och att innehållet följer etablerade säkerhetskrav.
            </p>
          </>
        </Accordion>
      )
    }
    <Accordion title="Pris">
      <PrivateBookingPricingList class="mt-4" />
    </Accordion>
  </Section>
  <Section class="pb-16" id="boka">
    <div class="booking-card">
      <h2 class="mt-0">{cta}</h2>
      <div class="max-w-prose">
        <p class="text-lg">
          Du föreslår ett datum, så återkommer vi med bekräftelse.
        </p>
      </div>
      <BookingForm maxParticipants={post.data.maxParticipants} name={cta} />
    </div>
  </Section>
</Layout>

<style>
  @import "../../styles/breakpoints.css";

  .booking-card {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
  }

  @media (--breakpoint-md) {
    .booking-card {
      padding: var(--space-8) var(--space-12);
    }
  }
</style>
