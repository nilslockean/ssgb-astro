---
import Section from "@components/Section.astro";
import config, { getPath, Slug } from "@config";
import Layout from "../layouts/Layout.astro";
import Link from "@components/Link.astro";

const phoneLink = `tel:${config.contact.phone
  .replace(/^0/, "+46")
  .replace(/[\s-]/g, "")}`;
---

<Layout
  metaDescription="Har du frågor om kurser, guidning eller upplägg? Hör av dig så återkommer vi så snart vi kan."
  metaTitle="Kontakta Dubbelåtta"
>
  <Section class="pb-0">
    <h1 class="mb-6">Kontakta oss</h1>
    <p class="mb-6 max-w-prose text-xl font-medium">
      Har du frågor om kurser, guidning eller upplägg? Hör av dig så återkommer
      vi så snart vi kan.
    </p>

    <p>
      <strong>Telefon:</strong>
      {" "}
      <Link href={`tel:${phoneLink}`}>{config.contact.phone}</Link>
    </p>
    <p class="mt-2">
      <strong>E-post:</strong>
      {" "}
      <Link href={`mailto:${config.contact.email}`}>{config.contact.email}</Link
      >
    </p>
  </Section>
  <Section class="mt-8">
    <div class="bg-brand-light max-w-4xl rounded-xl px-8 py-6 md:px-12 md:py-8">
      <h2 class="h3 mt-2">Skriv ett meddelande</h2>

      <form
        action={getPath(Slug.FORM_SUCCESS)}
        class="mt-8"
        data-netlify="true"
        method="POST"
        name="kontakt"
        netlify-honeypot="bot-field"
      >
        <p class="hidden">
          <label>
            Gör inte något här: <input name="bot-field" />
          </label>
        </p>

        <div class="grid gap-8 lg:grid-cols-2">
          <p>
            <label>
              Namn
              <br />
              <input name="name" required type="text" />
            </label>
          </p>

          <p>
            <label>
              E-post
              <br />
              <input name="email" required type="email" />
            </label>
          </p>

          <p>
            <label>
              Telefonnummer (valfritt)
              <br />
              <input name="phone" type="tel" />
            </label>
          </p>

          <p class="lg:col-start-1 lg:col-end-3">
            <label>
              Meddelande
              <br />
              <textarea
                name="message"
                placeholder="Berätta kort vad du undrar över eller vad du är ute efter."
                required></textarea>
            </label>
          </p>
        </div>

        <p class="mt-4 text-right">
          <button type="submit">Skicka meddelande</button>
        </p>
      </form>
    </div>
  </Section>
</Layout>
