---
import Section from "@components/Section.astro";
import config, { getPath, Slug } from "@config";
import Layout from "../layouts/Layout.astro";
import Link from "@components/Link.astro";

const phoneLink = `tel:${config.contact.phone
  .replace(/^0/, "+46")
  .replace(/[\s-]/g, "")}`;
---

<Layout
  metaDescription="Har du frågor om kurser, guidning eller upplägg? Hör av dig så återkommer vi så snart vi kan."
  metaTitle="Kontakta Sydsveriges Guidebyrå"
>
  <Section class="pb-0">
    <h1 class="mb-6">Kontakta oss</h1>
    <p class="mb-6 max-w-prose text-xl font-medium">
      Har du frågor om kurser, guidning eller upplägg? Hör av dig så återkommer
      vi så snart vi kan.
    </p>

    <p>
      <strong>Telefon:</strong>
      {" "}
      <Link href={`tel:${phoneLink}`}>{config.contact.phone}</Link>
    </p>
    <p class="mt-2">
      <strong>E-post:</strong>
      {" "}
      <Link href={`mailto:${config.contact.email}`}>{config.contact.email}</Link
      >
    </p>
  </Section>
  <Section class="mt-8">
    <div class="contact-form-card">
      <h2 class="h3 mt-2">Skriv ett meddelande</h2>

      <form
        action={getPath(Slug.FORM_SUCCESS)}
        class="contact-form"
        data-netlify="true"
        method="POST"
        name="Kontakta oss"
        netlify-honeypot="bot-field"
      >
        <p class="hidden">
          <label>
            Gör inte något här: <input name="bot-field" />
          </label>
        </p>

        <div class="contact-form__grid">
          <p>
            <label>
              Namn
              <br />
              <input name="name" required type="text" />
            </label>
          </p>

          <p>
            <label>
              E-post
              <br />
              <input name="email" required type="email" />
            </label>
          </p>

          <p>
            <label>
              Telefonnummer (valfritt)
              <br />
              <input name="phone" type="tel" />
            </label>
          </p>

          <p class="contact-form__message">
            <label>
              Meddelande
              <br />
              <textarea
                name="message"
                placeholder="Berätta kort vad du undrar över eller vad du är ute efter."
                required></textarea>
            </label>
          </p>
        </div>

        <p class="contact-form__submit">
          <button class="btn btn--primary" type="submit"
            >Skicka meddelande</button
          >
        </p>
      </form>
    </div>
  </Section>
</Layout>

<style>
  .contact-form-card {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
  }

  @media (--breakpoint-md) {
    .contact-form-card {
      padding: var(--space-8) var(--space-12);
    }
  }

  .contact-form {
    margin-top: var(--space-8);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (--breakpoint-lg) {
    .contact-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-form__message {
    grid-column: 1 / -1;
  }

  .contact-form__submit {
    margin-top: var(--space-4);
    text-align: right;
  }
</style>
