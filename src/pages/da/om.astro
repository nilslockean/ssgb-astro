---
import Section from "@components/Section.astro";
import Layout from "../../layouts/DaLayout.astro";
import Team from "@components/Team.astro";
import { getCollection } from "astro:content";

const teamMembers = await getCollection("team");
---

<Layout
  metaDescription="Sydsveriges Guidebyrå blev grundlagt i 2022 ud af et ønske om at gøre Skånes klipper tilgængelige for så mange som muligt."
  metaTitle="Om Sydsveriges Guidebyrå"
  tagline="Om Sydsveriges Guidebyrå"
>
  <Section class="pb-0">
    <h1 class="mb-6">Oplev et eventyr med naturen som din arena</h1>
    <p class="intro">
      Sydsveriges Guidebyrå tilbyder normerede klatrekurser, længere uddannelser
      og foredrag inden for lederskab i udsatte miljøer.
    </p>
  </Section>

  <Section>
    <h2>Medarbejdere</h2>
    <p class="intro mb-8">
      Virksomheden drives af Christian Persson, MSc in Outdoor Education,
      autoriseret klatrerinstruktør klippe samt eksaminator, men du møder også
      andre autoriserede instruktører under Sydsveriges Guidebyrås regi.
    </p>
    <Team entries={teamMembers} />
  </Section>
</Layout>
