---
import { getCollection } from "astro:content";
import { StructuredText } from "@datocms/astro";
import DaLayout from "../../layouts/DaLayout.astro";
import Section from "@components/Section.astro";
import ButtonBlock from "@components/dato/ButtonBlock.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "pages",
    (page) => page.data.language === "da",
  );
  return posts.map((post) => ({
    params: { page: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<DaLayout metaDescription={post.data.excerpt} metaTitle={post.data.title}>
  <Section class="pb-0">
    <h1 class="mb-6">{post.data.title}</h1>
    <p class="intro">{post.data.excerpt}</p>
  </Section>
  <div class="collection-entry p-8">
    {
      post.data.body && (
        <StructuredText
          data={post.data.body}
          blockComponents={{ ButtonRecord: ButtonBlock }}
        />
      )
    }
  </div>
</DaLayout>
