---
import Hero, { type HeroButton } from "@components/Hero.astro";
import Layout from "../../layouts/Layout.astro";
import CourseGrid from "@components/CourseGrid.astro";
import { getCourses, getLocalizedConfig } from "@lib/contentUtils";
import Eyebrow from "@components/Eyebrow.astro";
import { getPath, Slug } from "@config";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { localeSchema } from "../../schemas/locale.ts";

const featuredCourses = await getCourses((course) => course.data.featured);
const featuredTrips = await getCollection("trips");

const currentLocale = localeSchema.parse(Astro.currentLocale);
const siteConfig = await getLocalizedConfig(currentLocale);

const heroButtons: HeroButton[] = [
  {
    label: "Book et kursus",
    href: getRelativeLocaleUrl(currentLocale, getPath(Slug.COURSES)),
  },
  {
    label: "Stil et spørgsmål",
    href: getPath(Slug.CONTACT),
  },
];
---

<Layout
  metaDescription={siteConfig.siteTagline}
  tagline="Velkommen til Sydsveriges Guidebyrå"
>
  <Hero
    buttons={heroButtons}
    size="large"
    video="/ssgb-video-2.mp4"
    eyebrow="Oplev et eventyr med naturen som din arena"
    title={siteConfig.siteTagline.da}
  />

  <Section>
    <h2>Kurser</h2>
    <p class="intro">
      För dig som vill gå en klätterkurs inom klippklättring. Passar nybörjare
      och dig som kommit en bit på vägen och vill utveckla din klättring. Vi
      erbjuder våra kurser samtliga dagar i veckan, du bokar själv när det
      passar och hur många ni vill vara.
    </p>
    <Eyebrow class="mt-16 mb-4 ml-4">Populära kurser</Eyebrow>
    <CourseGrid class="mb-8" entries={featuredCourses}>
      <p class="flex items-end">
        <Link slug={Slug.COURSES}>Fler kurser &rarr;</Link>
      </p>
    </CourseGrid>
  </Section>

  <Section>
    <h2>Resor</h2>
    <p class="intro">
      För dig som vill uppleva klättring och bergsmiljöer utanför Sverige.
      Resorna riktar sig till klättrare med viss erfarenhet som vill utvecklas
      vidare i en ny miljö, med stöd av instruktör och guide. Fokus ligger på
      säkerhet, metodik och att ge dig förutsättningar att ta tillvara på
      möjligheterna som platsen erbjuder.
    </p>
    <Eyebrow class="mt-16 mb-4 ml-4">Våra resor</Eyebrow>
    <CourseGrid class="mb-8" entries={featuredTrips} />
  </Section>
</Layout>
