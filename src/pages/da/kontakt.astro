---
import Layout from "../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getLocalizedConfig } from "@lib/contentUtils";

const config = await getLocalizedConfig(Astro.currentLocale);
---

<Layout
  metaDescription="Kontakt Sydsveriges Guidebyrå med spørgsmål om klatrekurser, guidning eller private bookinger."
  metaTitle="Kontakt Sydsveriges Guidebyrå"
  tagline="Kontakt Sydsveriges Guidebyrå"
>
  <Section class="pb-0">
    <h1 class="mb-6">Kontakt os</h1>
    <p class="mb-6 max-w-prose text-xl font-medium">
      Har du spørgsmål om klatrekurser, guidning eller et privat arrangement?
      Send os en mail, så vender vi tilbage så hurtigt som muligt.
    </p>

    <p>
      <strong>Telefon:</strong>
      {" "}
      <Link href={`tel:${config.contact.phone}`}>{config.contact.phone}</Link>
    </p>
    <p class="mt-2">
      <strong>E-mail:</strong>
      {" "}
      <Link href={`mailto:${config.contact.email}`}>{config.contact.email}</Link
      >
    </p>
  </Section>
</Layout>
