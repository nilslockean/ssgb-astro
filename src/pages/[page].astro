---
import { getCollection } from "astro:content";
import StructuredText from "@features/dato/StructuredText.astro";
import Layout from "../layouts/Layout.astro";
import Section from "@components/Section.astro";
import FormSection from "@features/forms/FormSection.astro";
import { getEntry } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection(
    "pages",
    (page) => page.data.language === "sv",
  );
  return posts.map((post) => ({
    params: { page: post.data.slug },
    props: { post },
  }));
}

const {
  post: {
    data: { excerpt, title, body, form },
  },
} = Astro.props;
const formEntry = form && (await getEntry("forms", form));
---

<Layout metaDescription={excerpt} metaTitle={title}>
  <Section class="pb-0">
    <h1 class="mb-6">{title}</h1>
    <p class="intro">{excerpt}</p>
  </Section>
  <div class="collection-entry p-8">
    {body && <StructuredText data={body} />}
  </div>
  {formEntry && <FormSection form={formEntry} />}
</Layout>
