---
import Section from "@components/Section.astro";
import Layout from "../layouts/Layout.astro";
import Team from "@components/Team.astro";
import { getCollection } from "astro:content";
import CtaContact from "@components/CtaContact.astro";
import Link from "@components/Link.astro";

const teamMembers = await getCollection("team");
---

<Layout
  metaDescription="Sydsveriges Guidebyrå startades 2022 ur en vilja att tillgängliggöra Skånes klippor för så många som möjligt."
  metaTitle="Om Sydsveriges Guidebyrå"
  tagline="Om Sydsveriges Guidebyrå"
>
  <Section class="pb-0">
    <h1 class="mb-6">Upplev ett äventyr med naturen som arena</h1>
    <p class="intro">
      Sydsveriges Guidebyrå erbjuder normerade klätterkurser, längre utbildningar och föreläsningar inom ledarskap i utsatta miljöer.
    </p>
  </Section>

  <Section>
    <h2>Medarbetare</h2>
    <p class="intro mb-8">
      Verksamheten drivs av Christian Persson, MSc in Outdoor Education,
      auktoriserad klätterinstruktör klippa samt examinator, men du möter även andra
      auktoriserade instruktörer i Sydsveriges Guidebyrås regi.
    </p>
    <Team entries={teamMembers} />
  </Section>
  <CtaContact />
</Layout>
