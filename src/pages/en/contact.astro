---
import Layout from "../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getLocalizedConfig } from "@lib/contentUtils";

const config = await getLocalizedConfig(Astro.currentLocale);
---

<Layout
  metaDescription="Contact Sydsveriges Guidebyrå with questions about climbing courses, guiding, or private bookings."
  metaTitle="Contact Sydsveriges Guidebyrå"
  tagline="Contact Sydsveriges Guidebyrå"
>
  <Section class="pb-0">
    <h1 class="mb-6">Contact us</h1>
    <p class="mb-6 max-w-prose text-xl font-medium">
      Have questions about courses, guiding, or private arrangements? Send us a
      message and we will get back to you as soon as we can.
    </p>

    <p>
      <strong>Phone:</strong>
      {" "}
      <Link href={`tel:${config.contact.phone}`}>{config.contact.phone}</Link>
    </p>
    <p class="mt-2">
      <strong>Email:</strong>
      {" "}
      <Link href={`mailto:${config.contact.email}`}>{config.contact.email}</Link
      >
    </p>
  </Section>
</Layout>
