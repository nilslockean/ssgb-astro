---
import { getCollection } from "astro:content";
import { StructuredText } from "@datocms/astro";
import Layout from "../../layouts/Layout.astro";
import Section from "@components/Section.astro";
import ButtonBlock from "@features/dato/ButtonBlock.astro";
import PageInternalLink from "@features/dato/PageInternalLink.astro";
import ContactDetailInline from "@features/dato/ContactDetailInline.astro";

export async function getStaticPaths() {
  const posts = await getCollection(
    "pages",
    (page) => page.data.language === "en",
  );
  return posts.map((post) => ({
    params: { page: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout metaDescription={post.data.excerpt} metaTitle={post.data.title}>
  <Section class="pb-0">
    <h1 class="mb-6">{post.data.title}</h1>
    <p class="intro">{post.data.excerpt}</p>
  </Section>
  <div class="collection-entry p-8">
    {
      post.data.body && (
        <StructuredText
          data={post.data.body}
          blockComponents={{ ButtonRecord: ButtonBlock }}
          inlineBlockComponents={{ ContactDetailRecord: ContactDetailInline }}
          linkToRecordComponents={{ CourseRecord: PageInternalLink, PageRecord: PageInternalLink, TripRecord: PageInternalLink }}
        />
      )
    }
  </div>
</Layout>
