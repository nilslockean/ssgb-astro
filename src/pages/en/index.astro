---
import Hero, { type HeroButton } from "@components/Hero.astro";
import CourseGridItem from "@components/CourseGridItem.astro";
import Layout from "../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getLocalizedConfig } from "@lib/contentUtils";
import { getCollection } from "astro:content";

const siteConfig = await getLocalizedConfig(Astro.currentLocale);
const featuredCourses = (
  await getCollection(
    "courses",
    (course) => course.data.language === "en" && course.data.featured,
  )
).sort((a, b) => a.data.order - b.data.order);
const heroButtons: HeroButton[] = [
  {
    label: "View courses",
    href: "/en/courses",
  },
  {
    label: "Contact us",
    href: "/en/contact",
  },
];
---

<Layout
  metaDescription="Sydsveriges Guidebyrå offers rock climbing courses, guiding, and climbing trips in southern Sweden, Spain, and Italy."
  tagline="Welcome to Sydsveriges Guidebyrå"
>
  <Hero
    buttons={heroButtons}
    content="We help climbers build sound judgement, safer routines, and practical skills for real rock."
    eyebrow="Climbing courses and guided experiences"
    size="large"
    title={siteConfig.siteTagline}
    video="/ssgb-video-2.mp4"
  />

  <Section>
    <h2>Courses</h2>
    <p class="intro">
      Sydsveriges Guidebyrå offers outdoor climbing courses for beginners and
      experienced climbers who want to develop their skills on real rock. Our
      courses can be booked on dates that suit your group, with a strong focus
      on safety, clear methods, and practical experience.
    </p>
    <p>
      We are currently translating the main course information into English,
      starting with our core rock climbing and rescue courses.
    </p>
    <div class="english-course-grid">
      {
        featuredCourses.map((course) => (
          <CourseGridItem
            cta="Read about the course"
            excerpt={course.data.excerpt}
            href={`/en/courses/${course.data.slug || course.id}`}
            title={course.data.title}
          />
        ))
      }
    </div>
    <p>
      <Link href="/en/courses">View English course overview &rarr;</Link>
    </p>
  </Section>

  <Section>
    <h2>Questions?</h2>
    <p class="intro">
      If you are not sure which course fits your level, send us a short message.
      We are happy to help you choose the right next step.
    </p>
    <p>
      <Link href="/en/contact">Contact us &rarr;</Link>
    </p>
  </Section>
</Layout>

<style>
  .english-course-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    margin-block: var(--space-8);
  }

  @media (min-width: 64rem) {
    .english-course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
