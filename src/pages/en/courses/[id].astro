---
import { getCollection } from "astro:content";
import { PortableText } from "astro-portabletext";
import Accordion from "@components/Accordion.astro";
import ButtonGroup from "@components/ButtonGroup.astro";
import ButtonLink from "@components/ButtonLink.astro";
import Hero, { type HeroButton } from "@components/Hero.astro";
import Layout from "../../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { getLocalizedConfig } from "@lib/contentUtils";

export async function getStaticPaths() {
  const posts = await getCollection(
    "courses",
    (course) => course.data.language === "en",
  );

  return posts.map((post) => ({
    params: { id: post.data.slug || post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { norm } = post.data;
const siteConfig = await getLocalizedConfig(Astro.currentLocale);
const numDays = post.data.numDays.join("-");
const numDaysSuffix = numDays === "1" ? "day" : "days";
const numDaysDesc = `${numDays} ${numDaysSuffix}`;
const emailSubject = encodeURIComponent(post.data.title);
const heroButtons: HeroButton[] = [
  {
    label: post.data.cta,
    href: `mailto:${siteConfig.contact.email}?subject=${emailSubject}`,
  },
  {
    label: "View all courses",
    href: "/en/courses",
  },
];
---

<Layout
  metaDescription={post.data.excerpt}
  metaTitle={post.data.title}
  tagline={post.data.title}
>
  {
    post.data.heroImage ? (
      <Hero
        buttons={heroButtons}
        content={post.data.excerpt}
        image={post.data.heroImage}
        title={post.data.title}
      />
    ) : (
      <Hero
        buttons={heroButtons}
        content={post.data.excerpt}
        title={post.data.title}
      />
    )
  }

  <Section>
    <div class="collection-entry">
      {post.data.body && <PortableText value={post.data.body} />}
      <p>
        <strong>Duration:</strong>
        {numDaysDesc}.
      </p>
    </div>
  </Section>

  <Section>
    {
      post.data.prerequisites && (
        <Accordion title="Prerequisites">
          <p>{post.data.prerequisites}</p>
        </Accordion>
      )
    }
    {
      norm?.url && (
        <Accordion title="Course standard">
          <p>
            This course follows the Swedish Climbing Federation standard for{" "}
            <Link href={norm.url} target="_blank">
              {norm.title}
            </Link>
            .
          </p>
        </Accordion>
      )
    }
    <Accordion title="Booking">
      <p>
        Courses are usually booked privately for your group on dates that suit
        you, subject to instructor availability and suitable weather.
      </p>
      <ButtonGroup class="mt-6">
        <ButtonLink
          href={`mailto:${siteConfig.contact.email}?subject=${emailSubject}`}
          variant="primary"
        >
          {post.data.cta}
        </ButtonLink>
      </ButtonGroup>
    </Accordion>
  </Section>
</Layout>
