---
import CourseGridItem from "@components/CourseGridItem.astro";
import Layout from "../../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import PageHead from "@components/PageHead.astro";
import Section from "@components/Section.astro";
import { getCollection } from "astro:content";

const courses = (
  await getCollection("courses", (course) => course.data.language === "en")
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  metaDescription="English information about climbing courses with Sydsveriges Guidebyrå in southern Sweden."
  metaTitle="Climbing Courses"
  tagline="Climbing courses in southern Sweden"
>
  <PageHead
    content="We are translating our core climbing courses into English. More courses are available in Swedish, and you are always welcome to contact us if you are unsure which course fits your experience."
    title="Climbing courses"
  />

  <Section class="mt-0 pt-0">
    <div class="english-course-grid">
      {
        courses.map((course) => (
          <CourseGridItem
            cta="Read about the course"
            excerpt={course.data.excerpt}
            href={`/en/courses/${course.data.slug || course.id}`}
            title={course.data.title}
          />
        ))
      }
    </div>
  </Section>

  <Section>
    <h2>More courses</h2>
    <p class="intro">
      We also offer additional climbing and rescue courses that are not yet
      translated into English. You can read the full current course list in
      Swedish, or contact us and we will help you find the right course.
    </p>
    <p>
      <Link href="/kurser">View all courses in Swedish &rarr;</Link>
    </p>
  </Section>
</Layout>

<style>
  .english-course-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 64rem) {
    .english-course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
