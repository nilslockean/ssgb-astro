---
import CourseGridItem from "@features/courses/CourseGridItem.astro";
import Layout from "../../../layouts/Layout.astro";
import Link from "@components/Link.astro";
import PageHead from "@components/PageHead.astro";
import Section from "@components/Section.astro";
import { getCollection } from "astro:content";

const courses = (
  await getCollection("courses", (course) => course.data.language === "en")
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  metaDescription="Rock climbing and self-rescue courses with Sydsveriges Guidebyrå in southern Sweden."
  metaTitle="Climbing Courses"
  tagline="Climbing courses in southern Sweden"
>
  <PageHead
    content="Courses for climbers who want to build practical outdoor skills on real rock, from first steps outside to traditional leading and self-rescue."
    title="Climbing courses"
  />

  <Section class="mt-0 pt-0">
    <div class="english-course-grid">
      {
        courses.map((course) => (
          <CourseGridItem
            cta="Read about the course"
            excerpt={course.data.excerpt}
            href={`/en/courses/${course.data.slug || course.id}`}
            title={course.data.title}
          />
        ))
      }
    </div>
  </Section>

  <Section>
    <h2>Not sure where to start?</h2>
    <p class="intro">
      Tell us about your previous climbing experience and what you want to be
      able to do outdoors. We will help you choose the right course or suggest a
      private setup for your group.
    </p>
    <p>
      <Link href="/en/prices">View prices &rarr;</Link>
      {" "}
      <Link href="/en/contact">Contact us &rarr;</Link>
    </p>
  </Section>
</Layout>

<style>
  .english-course-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 64rem) {
    .english-course-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
