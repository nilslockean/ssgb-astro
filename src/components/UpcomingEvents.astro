---
import type { CollectionEntry } from "astro:content";
import List from "./List.astro";
import Link from "./Link.astro";
import { cn } from "@lib/cn";

interface Props {
  events: CollectionEntry<"events">[];
}

const { events } = Astro.props;
---

{
  events.length > 0 ? (
    <List>
      {events.map((event) => (
        <li
          class={cn({
            italic: event.data.draft,
          })}
        >
          <Link href={event.data.ticketUrl}>{event.data.title.sv}</Link>
        </li>
      ))}
    </List>
  ) : (
    <slot>
      <p>
        <strong>Inga öppna kurstillfällen inplanerade just nu.</strong>
      </p>
    </slot>
  )
}
