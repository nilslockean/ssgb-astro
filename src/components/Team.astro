---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import TeamMember from "./TeamMember.astro";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"team">[];
}

const { entries, class: className, ...rest } = Astro.props;
---

<ul
  class:list={["team grid lg:grid-cols-2 xl:grid-cols-3", className]}
  {...rest}
>
  {entries.map((person) => <TeamMember {person} />)}
</ul>

<style>
  .team {
    gap: var(--space-8);
  }
</style>
