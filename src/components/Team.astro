---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import TeamMember from "./TeamMember.astro";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"team">[];
}

const { entries, class: className, ...rest } = Astro.props;
---

<ul class:list={["team", className]} {...rest}>
  {entries.map((person) => <TeamMember {person} />)}
</ul>

<style>
  .team {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (--breakpoint-lg) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (--breakpoint-2xl) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
