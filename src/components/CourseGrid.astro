---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import CourseGridItem from "./CourseGridItem.astro";
import { localePath } from "@lib/i18nUtils";
import { localeSchema } from "src/schemas/locale";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"courses">[];
}

const { entries, class: className, ...rest } = Astro.props;
const locale = localeSchema.parse(Astro.currentLocale);
---

<ul
  class:list={[
    "course-grid",
    "grid-cols-1",
    "lg:grid-cols-2",
    "xl:grid-cols-3",
    className,
  ]}
  {...rest}
>
  {
    entries.map((course) => {
      const title = course.data.shortName || course.data.title;
      const href = localePath(course.data.slugId, locale);
      const cta = `Läs mer om ${title.replaceAll("&shy;", "").toLowerCase()}`;

      return (
        <CourseGridItem
          cta={cta}
          excerpt={course.data.excerpt}
          href={href}
          title={title}
        />
      );
    })
  }
  <slot />
</ul>

<style>
  .course-grid {
    display: grid;
    gap: var(--space-8);
  }
</style>
