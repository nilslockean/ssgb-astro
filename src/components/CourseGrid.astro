---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import CourseGridItem from "./CourseGridItem.astro";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"courses">[];
}

const { entries, class: className, ...rest } = Astro.props;
---

<ul class:list={["course-grid", className]} {...rest}>
  {entries.map((course) => <CourseGridItem {course} />)}
  <slot />
</ul>

<style>
  .course-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (--breakpoint-lg) {
    .course-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (--breakpoint-2xl) {
    .course-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
