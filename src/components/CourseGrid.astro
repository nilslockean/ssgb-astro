---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import CourseGridItem from "./CourseGridItem.astro";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"courses">[];
}

const { entries, class: className, ...rest } = Astro.props;
---

<ul
  class:list={[
    "course-grid",
    "grid-cols-1",
    "lg:grid-cols-2",
    "xl:grid-cols-3",
    className,
  ]}
  {...rest}
>
  {entries.map((course) => <CourseGridItem {course} />)}
  <slot />
</ul>

<style>
  .course-grid {
    display: grid;
    gap: var(--space-8);
  }
</style>
