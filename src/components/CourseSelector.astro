---
import { getCollection } from "astro:content";
import { type Slug } from "@lib/routeUtils";
import Accordion from "./Accordion.astro";
import Link from "./Link.astro";
import Section from "./Section.astro";

const entries = await getCollection("courseSelector");
---

<Section>
  <h2 class="mb-4">Vilken kurs passar dig?</h2>
  {
    entries.map((entry) => (
      <Accordion title={entry.data.title}>
        {entry.data.body.map((paragraph) => (
          <p>
            {paragraph.map((segment) =>
              segment.slug ? (
                <Link slug={segment.slug as Slug}>{segment.text}</Link>
              ) : (
                segment.text
              ),
            )}
          </p>
        ))}
      </Accordion>
    ))
  }
</Section>
