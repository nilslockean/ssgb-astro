---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import type { LocalImageProps } from "astro:assets";
import { cn } from "@lib/cn";

interface Props extends HTMLAttributes<"div"> {
  image: LocalImageProps;
  reverse?: boolean;
}

const { image, reverse, class: className, ...rest } = Astro.props;
---

<div
  {...rest}
  class={cn("grid gap-8 lg:py-16 lg:grid-cols-12 items-center", className)}
>
  <div
    class:list={[
      "ring-brand-light mr-auto overflow-clip rounded-2xl bg-black ring-4 lg:col-span-5",
      { "order-last": reverse },
    ]}
  >
    <Image
      class="h-auto w-full object-cover opacity-80 grayscale transition-all hover:opacity-100 hover:grayscale-0"
      {...image}
    />
  </div>
  <div
    class:list={[
      "w-full place-self-center lg:col-span-7",
      { "order-first": reverse },
    ]}
  >
    <slot />
  </div>
</div>
