---
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";
import type { LocalImageProps } from "astro:assets";

interface Props extends HTMLAttributes<"div"> {
  image: LocalImageProps;
  reverse?: boolean;
}

const { image, reverse, class: className, ...rest } = Astro.props;
---

<div class:list={["media-block", className]} {...rest}>
  <div class:list={["media-block__image", { "media-block__image--reverse": reverse }]}>
    <Image class="media-block__img" {...image} />
  </div>
  <div class:list={["media-block__content", { "media-block__content--reverse": reverse }]}>
    <slot />
  </div>
</div>

<style>
  .media-block {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (--breakpoint-lg) {
    .media-block {
      grid-template-columns: repeat(12, 1fr);
      padding-block: var(--space-16);
    }
  }

  .media-block__image {
    margin-right: auto;
    overflow: clip;
    border-radius: var(--border-radius-2xl);
    background-color: var(--color-black);
    outline: 4px solid var(--color-brand-light);
  }

  @media (--breakpoint-lg) {
    .media-block__image {
      grid-column: span 5;
    }
  }

  .media-block__image--reverse {
    order: 1;
  }

  @media (--breakpoint-lg) {
    .media-block__image--reverse {
      order: 0;
    }
  }

  .media-block__img {
    height: auto;
    width: 100%;
    object-fit: cover;
    opacity: 0.8;
    filter: grayscale(100%);
    transition:
      opacity var(--default-transition-duration) var(--default-transition-timing-function),
      filter var(--default-transition-duration) var(--default-transition-timing-function);
  }

  .media-block__img:hover {
    opacity: 1;
    filter: grayscale(0%);
  }

  .media-block__content {
    width: 100%;
    place-self: center;
  }

  @media (--breakpoint-lg) {
    .media-block__content {
      grid-column: span 7;
    }
  }

  .media-block__content--reverse {
    order: 0;
  }

  @media (--breakpoint-lg) {
    .media-block__content--reverse {
      order: 1;
    }
  }
</style>
