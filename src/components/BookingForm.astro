---
import { getPath, Slug } from "@config";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"form"> {
  name: string;
  maxParticipants: number | null;
  includeDate?: boolean;
  dateLabel?: string;
  submitLabel?: string;
  messagePlaceholder?: string;
}

const {
  name,
  maxParticipants,
  messagePlaceholder,
  includeDate = true,
  dateLabel = "Önskat startdatum",
  submitLabel = "Skicka bokningsförfrågan",
  class: className,
  ...rest
} = Astro.props;
---

<form
  class:list={["booking-form", className]}
  action={getPath(Slug.FORM_SUCCESS)}
  data-netlify="true"
  method="POST"
  name={name}
  netlify-honeypot="bot-field"
  {...rest}
>
  <p class="hidden">
    <label>
      Gör inte något här: <input name="bot-field" />
    </label>
  </p>

  <div class="booking-form__grid">
    <p>
      <label>
        E-post
        <br />
        <input name="email" required type="email" />
      </label>
    </p>

    <p>
      <label>
        Telefonnummer
        <br />
        <input name="phone" required type="tel" />
      </label>
    </p>

    { includeDate && (
      <p>
        <label>
          {dateLabel}
          <br />
          <input name="date" required type="date" />
        </label>
      </p>
    )}

    { maxParticipants !== null && (
      <p>
        <label>
          Antal deltagare
          <br />
          <input
            max={maxParticipants}
            min="1"
            name="participants"
            required
            type="number"
          />
        </label>
      </p>
    )}

    <p class="booking-form__message">
      <label>
        Meddelande (valfritt)
        <br />
        <textarea name="message" placeholder={messagePlaceholder}></textarea>
      </label>
    </p>
  </div>

  <p class="booking-form__submit">
    <button type="submit" class="btn btn--primary">{submitLabel}</button>
  </p>
</form>

<style>
  @import "../styles/breakpoints.css";

  .booking-form {
    margin-top: var(--space-8);
  }

  .booking-form__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (--breakpoint-lg) {
    .booking-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .booking-form__message {
    grid-column: 1 / -1;
  }

  @media (--breakpoint-lg) {
    .booking-form__message {
      grid-column: 1 / -1;
    }
  }

  .booking-form__submit {
    margin-top: var(--space-4);
    text-align: right;
  }
</style>
