---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "./Eyebrow.astro";
import Section from "./Section.astro";

interface Props extends HTMLAttributes<"section"> {
  eyebrow?: string;
  content?: string;
  title: string;
  centered?: boolean;
}

const {
  eyebrow,
  title,
  content,
  centered,
  class: className,
  ...rest
} = Astro.props;
---

<Section
  class:list={[
    "page-head",
    { "page-head--centered": centered },
    className,
  ]}
  {...rest}
>
  {
    eyebrow && (
      <Eyebrow class={centered ? "text-center" : undefined}>{eyebrow}</Eyebrow>
    )
  }
  <h1
    class:list={["page-head__title", { "page-head__title--centered": centered }]}
    set:html={title}
  />
  <div
    class:list={[
      "page-head__intro",
      { "page-head__intro--centered": centered },
    ]}
  >
    <slot>
      <p>
        {content}
      </p>
    </slot>
  </div>
  <slot name="buttons" />
</Section>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .page-head--centered {
    justify-content: center;
    align-items: center;
  }

  .page-head__title {
    font-size: var(--text-h1);
  }

  .page-head__title--centered {
    text-align: center;
  }

  @media (--breakpoint-lg) {
    .page-head__title--centered {
      max-width: 80%;
    }
  }

  .page-head__intro {
    color: var(--color-default);
  }

  .page-head__intro--centered {
    text-align: center;
  }
</style>
