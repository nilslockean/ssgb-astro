---
import { type Slug } from "@lib/routeUtils";
import { localePath } from "@lib/i18nUtils";
import type { HTMLAttributes } from "astro/types";
import { localeSchema } from "src/schemas/locale";

export interface Props extends HTMLAttributes<"a"> {
  slug?: Slug;
}

const { slug, href, class: className, ...rest } = Astro.props;
const locale = localeSchema.parse(Astro.currentLocale);
const to = slug ? localePath(slug, locale) : href;
---

<a class:list={["link", className]} href={to} {...rest}><slot /></a>

<style>
  .link {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-link);
  }

  .link:hover {
    text-underline-offset: 1px;
    color: var(--color-link-hover);
  }
</style>
