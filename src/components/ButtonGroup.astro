---
import type { HTMLAttributes, HTMLTag } from "astro/types";

type Props<T extends HTMLTag = "div"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;

const Tag: HTMLTag = as || "div";
---

<Tag class:list={["button-group", className]} {...rest}>
  <slot />
</Tag>

<style>
  .button-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    row-gap: var(--space-4);
  }

  .button-group.justify-end {
    justify-content: flex-end;
  }

  .button-group.flex-1 {
    flex: 1;
  }
</style>
