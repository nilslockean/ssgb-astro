---
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import ButtonGroup from "./ButtonGroup.astro";
import ButtonLink from "./ButtonLink.astro";
import Eyebrow from "./Eyebrow.astro";
import type { SanityImage } from "../schemas/sanity";

export type HeroButton = { label: string; href: string; target?: string };

interface Props extends HTMLAttributes<"section"> {
  image?: ImageMetadata | SanityImage;
  video?: string;
  title: string;
  content: string;
  size?: "default" | "large";
  buttons?: HeroButton[];
  eyebrow?: string;
}

const {
  image,
  video,
  title,
  content,
  buttons,
  eyebrow,
  size = "default",
  class: className,
  ...rest
} = Astro.props;
---

<section
  class:list={[
    "hero",
    { "hero--large": size === "large", "hero--video": Boolean(video) },
    className,
  ]}
  {...rest}
>
  {
    video ? (
      <video autoplay class="hero__video" loop muted playsinline>
        <source src={video} type="video/mp4" />
      </video>
    ) : image ? (
      <Picture
        alt=""
        class="hero__img"
        fetchpriority="high"
        formats={["avif", "webp"]}
        loading="eager"
        role="presentation"
        sizes="(max-width: 640px) 100vw, (max-width: 1024px) 90vw, 80vw"
        src={"format" in image ? image : image.src}
        width={"format" in image ? undefined : image.width}
        height={"format" in image ? undefined : image.height}
        widths={[640, 1024, 1600]}
      />
    ) : null
  }
  <span aria-hidden="true" class="hero__overlay"></span>
  <div class="hero__content text-white">
    <div class="hero__inner">
      <div>
        {eyebrow && <Eyebrow class="hero__eyebrow">{eyebrow}</Eyebrow>}
        <h1 class="hero__title text-white text-h1" set:html={title} />
      </div>

      <div class="hero__bottom">
        <p class="hero__text intro">{content}</p>

        {
          buttons && buttons.length && (
            <ButtonGroup class="hero__buttons">
              {buttons.map(({ label, href, target }, i) => (
                <ButtonLink
                  href={href}
                  target={target}
                  variant={i === 0 ? "primary" : "default"}
                >
                  {label}
                </ButtonLink>
              ))}
            </ButtonGroup>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  @import "../styles/breakpoints.css";

  @keyframes blur-on-scroll {
    from {
      filter: blur(0px) grayscale(0%);
    }
    to {
      filter: blur(48px) grayscale(0%);
    }
  }

  .hero {
    position: relative;
    padding: var(--space-8);
    overflow: clip;
  }

  .hero--large .hero__inner {
    min-height: 80vh;
  }

  .hero__overlay {
    --opacity: 0.9;
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      65deg,
      rgb(0 0 0 / var(--opacity)),
      rgb(0 0 0 / 0.5)
    );
  }

  .hero--video .hero__overlay {
    --opacity: 0.65;
  }

  .hero__img {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    animation: blur-on-scroll linear;
    animation-timeline: scroll();
  }

  .hero__video {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    animation: blur-on-scroll linear;
    animation-timeline: scroll();
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    padding-bottom: var(--space-6);
    gap: 16vw;
    justify-content: space-between;
  }

  .hero__eyebrow {
    color: rgb(255 255 255 / 0.7);
  }

  .hero__title {
    font-size: var(--text-h1);
    max-width: 30ch;
  }

  @media (--breakpoint-lg) {
    .hero__title {
      font-size: var(--text-h0);
    }
  }

  .hero__bottom {
    max-width: var(--prose);
  }

  .hero__text {
    font-size: var(--text-xl);
  }

  .hero__buttons {
    margin-top: var(--space-10);
    font-size: var(--text-lg);
  }

  @media (--breakpoint-lg) {
    .hero__buttons {
      margin-top: var(--space-6);
    }
  }
</style>
