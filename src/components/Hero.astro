---
import HeroWithMedia from "./HeroWithMedia.astro";
import HeroWithoutMedia from "./HeroWithoutMedia.astro";
import type { HTMLAttributes } from "astro/types";
import type { ImageMetadata } from "astro";
import type { DatoImage, DatoResponsiveImage } from "../schemas/dato";

export type HeroButton = { label: string; href: string; target?: string };

export interface HeroProps extends HTMLAttributes<"section"> {
  image?: ImageMetadata | DatoImage;
  data?: DatoResponsiveImage;
  video?: string;
  title: string;
  content: string;
  buttons?: HeroButton[];
  eyebrow?: string;
}

interface Props extends HeroProps {}

const { image, data, video, ...sharedProps } = Astro.props;
const hasMedia = Boolean(video || data || image);
---

{
  hasMedia ? (
    <HeroWithMedia {...sharedProps} image={image} data={data} video={video}>
      <slot name="metadata" slot="metadata" />
    </HeroWithMedia>
  ) : (
    <HeroWithoutMedia {...sharedProps}>
      <slot name="metadata" slot="metadata" />
    </HeroWithoutMedia>
  )
}
