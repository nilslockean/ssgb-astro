---
import type { HTMLAttributes, HTMLTag } from "astro/types";

type Props<T extends HTMLTag = "p"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;

const Tag: HTMLTag = as || "p";
---

<Tag class:list={["eyebrow", className]} {...rest}>
  <slot />
</Tag>

<style>
  .eyebrow {
    font-family: var(--font-barlow-condensed);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }

  .eyebrow.text-center {
    text-align: center;
  }

  .eyebrow.text-white {
    color: var(--color-white);
  }

  .eyebrow.mb-8 {
    margin-bottom: var(--space-8);
  }
</style>
