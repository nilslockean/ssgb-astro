---
import type { HTMLAttributes } from "astro/types";
import { formatPrice } from "@lib/stringUtils";
import { getLocalizedConfig } from "@lib/contentUtils";

interface Props extends HTMLAttributes<"ul"> {}

const { class: className, ...rest } = Astro.props;
const config = await getLocalizedConfig(Astro.currentLocale);
const {
  defaultPrices: { privateSingle, privateDouble, privateMany },
} = config;

const list = [
  ["1 person", privateSingle],
  ["2 personer", privateDouble],
  ["3-4 personer", privateMany],
] as const satisfies [string, number][];
---

<ul class:list={[className]} {...rest}>
  {
    list.map(([label, price]) => (
      <li>
        <strong>{label}:</strong> {formatPrice([price])} per person och dag
      </li>
    ))
  }
</ul>
