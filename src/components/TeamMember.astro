---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { Image } from "@datocms/astro/Image";
import Pill from "@components/Pill.astro";

interface Props extends HTMLAttributes<"li"> {
  person: CollectionEntry<"team">;
}
const {
  person: {
    data: { name, bio, image, imageData, alt, titles },
  },
} = Astro.props;
---

<div class="team-member">
  <figure class="team-member__figure">
    <div class="team-member__image-wrapper">
      {
        imageData ? (
          <Image
            data={imageData}
            pictureStyle={{ display: "block", width: "100%" }}
            imgClass="team-member__image"
            imgStyle={{ maxWidth: "none" }}
            usePlaceholder
          />
        ) : (
          <img
            alt={alt ?? ""}
            class="team-member__image"
            height={image?.height ?? 800}
            src={image?.src ?? ""}
            width={image?.width ?? 600}
          />
        )
      }
    </div>
  </figure>

  <div class="team-member__content">
    <h3 class="team-member__name font-heading mt-0">{name}</h3>
    {
      titles.length > 0 && (
        <ul class="list-reset team-member__titles">
          {titles.map(({ title, description }) => (
            <li>
              <Pill label={title} tooltip={description} />
            </li>
          ))}
        </ul>
      )
    }
    <p>{bio}</p>
  </div>
</div>

<style>
  .team-member {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .team-member__name {
    margin-bottom: var(--space-4);
  }

  .team-member__image-wrapper {
    overflow: clip;
    border-radius: var(--border-radius-2xl);
  }

  .team-member__image {
    width: 100%;
    height: auto;
  }

  .team-member__content {
    flex-grow: 1;
    padding: var(--space-8);
  }

  .team-member__titles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block: var(--space-4);
    margin-bottom: var(--space-6);
  }
</style>
