---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { Image } from "astro:assets";

interface Props extends HTMLAttributes<"li"> {
  person: CollectionEntry<"team">;
}
const {
  person: {
    data: { name, bio, image, alt, title },
  },
} = Astro.props;
---

<div class="team-member">
  <figure class="team-member__figure">
    <div class="team-member__image-wrapper">
      <Image
        alt={alt ?? ""}
        class="team-member__image"
        height={image?.height ?? 800}
        loading="lazy"
        src={image?.src ?? ""}
        width={image?.width ?? 600}
      />
    </div>
  </figure>

  <div class="team-member__content">
    <h3 class="team-member__name font-heading mt-0">{name}</h3>
    {title && <p class="team-member__title">{title}</p>}
    <p>{bio}</p>
  </div>
</div>

<style>
  .team-member {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .team-member__image-wrapper {
    overflow: clip;
    border-radius: var(--border-radius-2xl);
  }

  .team-member__image {
    width: 100%;
    height: auto;
  }

  .team-member__content {
    flex-grow: 1;
    padding: var(--space-8);
  }

  .team-member__title {
    margin-bottom: var(--space-4);
    font-weight: bold;
  }
</style>
