---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import { getImage } from "astro:assets";
import { Image } from "astro:assets";

interface Props extends HTMLAttributes<"li"> {
  person: CollectionEntry<"team">;
}

const {
  person: {
    data: { name, description, image, alt },
  },
} = Astro.props;

const imageData = await getImage({
  src: image,
  format: "webp",
  width: 600,
  height: 800,
});
---

<li class="team-member">
  <figure class="team-member__figure">
    <div class="team-member__image-wrapper">
      <Image
        alt={alt}
        class="team-member__image"
        height={800}
        layout="constrained"
        loading="lazy"
        src={imageData.src}
        width={600}
      />
    </div>
  </figure>

  <div class="team-member__content">
    <h3 class="team-member__name font-heading mt-0 normal-case">{name}</h3>
    <p>{description}</p>
  </div>
</li>

<style>
  .team-member {
    background-color: var(--color-line);
    border-radius: var(--border-radius-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .team-member__image-wrapper {
    overflow: clip;
    border-radius: var(--border-radius-2xl);
  }

  .team-member__image {
    width: 100%;
    filter: grayscale(100%);
  }

  .team-member__content {
    flex-grow: 1;
    padding: var(--space-8);
  }
</style>
