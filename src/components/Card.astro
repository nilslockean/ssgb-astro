---
type Props = {
  as?:
    | "li"
    | "div"
    | "section"
    | "article"
    | "header"
    | "footer"
    | "nav"
    | "main"
    | "aside";
  headingLevel?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  title?: string;
  href?: string;
  content?: string;
  image?: { src: string; alt?: string };
  class?: string;
};

const {
  as: Tag = "div",
  headingLevel: HeadingTag = "h3",
  title,
  href,
  content,
  image,
  class: className,
} = Astro.props;
---

<Tag class:list={["card", className]}>
  {
    image && (
      <div class="card__img-wrapper">
        <img
          class="card__img"
          src={image.src}
          alt={image.alt ?? ""}
          role={!image.alt ? "presentation" : null}
          loading="lazy"
        />
      </div>
    )
  }
  <div class="card__body">
    {
      title && (
        <HeadingTag class="card__title">
          {href ? (
            <a class="card__link" href={href} set:html={title} />
          ) : (
            <span set:html={title} />
          )}
        </HeadingTag>
      )
    }
    {
      content ? (
        <div class="card__content" set:html={content} />
      ) : (
        <div class="card__content">
          <slot />
        </div>
      )
    }
    <div class="card__actions">
      <slot name="actions" />
    </div>
  </div>
</Tag>

<style>
  .card {
    position: relative;
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .card__img-wrapper {
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: var(--space-8);
  }

  .card__link {
    text-decoration: none;
    color: inherit;
  }

  .card__link:hover {
    text-decoration: underline;
  }

  .card__title {
    margin-top: 0;
  }

  .card__content {
    flex-grow: 1;
  }

  .card__actions {
    margin-top: var(--space-8);
  }
</style>
