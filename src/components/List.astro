---
import type { HTMLAttributes, HTMLTag } from "astro/types";

type Props<T extends HTMLTag = "ul"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;

const Tag: HTMLTag = as || "ul";
---

<Tag class:list={["list", className]} {...rest}>
  <slot />
</Tag>

<style>
  .list {
    margin-left: var(--space-5);
    list-style: disc;
  }

  .list > li + li {
    margin-top: var(--space-1);
  }

  .list.my-4 {
    margin-block: var(--space-4);
  }

  .list.mb-4 {
    margin-bottom: var(--space-4);
  }
</style>
