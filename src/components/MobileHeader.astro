---
import NavLink from "./NavLink.astro";
import SiteLogo from "@features/navigation/SiteLogo.astro";
import type { Navigation } from "@lib/routeUtils";
import LanguageList from "@features/locale/LanguageList.astro";
import { LOCALES } from "@lib/i18nUtils";
import { localeSchema } from "../schemas/locale";
import LocaleFlag from "@components/flags/LocaleFlag.astro";

interface Props {
  links: Navigation;
}
const { links } = Astro.props;
const currentLocale = localeSchema.parse(Astro.currentLocale);
---

<header class="flex justify-between md:hidden">
  <SiteLogo />
  <div class="header-actions">
    <button
      aria-haspopup="true"
      aria-label={`Byt språk / Change language. Current language: ${LOCALES[currentLocale]}`}
      id="lang-toggle"
      popovertarget="lang-menu"
    >
      <LocaleFlag locale={currentLocale} size={28} />
    </button>
    <button aria-haspopup="dialog" aria-label="Toggle menu" id="menu-toggle">
      <span class="sr-only">Öppna eller stäng huvudmenyn</span>
      <svg
        aria-hidden="true"
        class="mobile-menu__icon--open"
        focusable="false"
        height="24"
        viewBox="0 0 48 24"
        width="48"
        xmlns="http://www.w3.org/2000/svg"
      >
        <rect height="1.5" width="42" x="4" y="7.5"></rect>
        <rect height="1.5" width="42" x="4" y="15"></rect>
      </svg>
      <svg
        aria-hidden="true"
        class="mobile-menu__icon--close hidden"
        focusable="false"
        height="24"
        viewBox="0 0 48 24"
        width="48"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M31.2479 3.69151L15.6915 19.2479L16.7522 20.3085L32.3085 4.75217L31.2479 3.69151Z"
        ></path>
        <path
          d="M32.3085 19.2479L16.7522 3.69153L15.6915 4.75219L31.2479 20.3085L32.3085 19.2479Z"
        ></path>
      </svg>

      <!-- Close button (mobile only) -->
      <!-- <div class="flex justify-end items-center mb-8">
			<button id="menu-close" class="p-2 rounded focus:outline-none focus:ring">
				<span class="sr-only">Stäng huvudmenyn</span>
				<svg
					width="48"
					height="24"
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 48 24"
					aria-hidden="true"
					focusable="false"
				>
					<rect x="4" y="11.25" width="42" height="1.5"></rect>
				</svg>
			</button>
		</div> -->
    </button>
  </div>
</header>

<div id="lang-menu" popover>
  <LanguageList />
</div>

<!-- Navigation -->
<nav
  aria-label="Primary"
  class="interpolate-size z-50 hidden flex-col"
  id="primary-nav"
>
  <ul class="nav-links flex flex-col flex-wrap items-start gap-4 text-xl">
    {
      links.map((item) => (
        <li>
          <a class="font-heading text-5xl" href={item.link.path}>
            {item.link.label}
          </a>
          {item.subMenu && (
            <ul class="mt-6 ml-4 flex flex-col gap-2">
              {item.subMenu.nav.map((entry) => (
                <li>
                  <NavLink href={entry.link.path} set:html={entry.link.label} />
                </li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  @supports (interpolate-size: allow-keywords) {
    .interpolate-size {
      interpolate-size: allow-keywords;
      height: auto;
      transition: height 300ms;
    }
  }

  header {
    background-color: var(--color-surface-dark);
    border-bottom: 1px solid var(--color-line);
    padding: var(--space-4);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  button {
    appearance: none;
    border: none;
    background: transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
  }

  svg {
    fill: white;
  }

  #lang-toggle {
    anchor-name: --lang-toggle;
    border-radius: 50%;
    padding: 2px;
  }

  #lang-toggle:focus-visible {
    outline: 2px solid var(--color-white);
    outline-offset: 2px;
  }

  #lang-toggle :global(.flag-icon) {
    outline: 2px solid white;
  }

  #lang-menu {
    inset: unset;
    position: fixed;
    position-anchor: --lang-toggle;
    top: anchor(--lang-toggle bottom);
    right: anchor(--lang-toggle right);
    margin-block-start: var(--space-2);
    padding: var(--space-2);
    background-color: var(--color-surface-dark);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md, 6px);
    min-width: 9rem;
  }

  #lang-menu::backdrop {
    background: transparent;
  }

  #lang-menu :global(a:hover) {
    background-color: var(--color-surface-darker);
  }

  nav {
    background-color: var(--color-surface-darker);
    padding: var(--space-12) var(--space-8) var(--space-16);
  }

  a {
    color: var(--color-default);
  }

  #menu-toggle[aria-expanded="true"] .mobile-menu__icon--open,
  #menu-toggle[aria-expanded="false"] .mobile-menu__icon--close {
    display: none;
  }

  #menu-toggle[aria-expanded="false"] .mobile-menu__icon--open,
  #menu-toggle[aria-expanded="true"] .mobile-menu__icon--close {
    display: block;
  }
</style>

<!-- Client-side script for toggling menu -->
<script>
  const toggle = document.getElementById("menu-toggle");
  const close = document.getElementById("menu-close");
  const nav = document.getElementById("primary-nav");

  toggle?.addEventListener("click", () => {
    nav?.classList.toggle("hidden");
    toggle.setAttribute(
      "aria-expanded",
      nav?.classList.contains("hidden") ? "false" : "true",
    );
  });

  close?.addEventListener("click", () => {
    nav?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  });

  // Close menu on link click (useful on mobile)
  nav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      nav.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    });
  });
</script>
