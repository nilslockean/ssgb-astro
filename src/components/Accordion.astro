---
import { cn } from "@lib/cn.ts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"details"> {
  title: string;
}

const { title, class: className, ...rest } = Astro.props;
---

<details
  {...rest}
  class={cn(
    "border-b border-line group first:border-t portable-text",
    className,
  )}
>
  <summary class="flex w-full cursor-pointer items-baseline gap-4 py-6">
    <span class="transition-all group-open:rotate-45">
      <svg
        fill="none"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g clip-path="url(#clip0_223_2)">
          <path
            d="M8.5 7.5H16V8.5H8.5V16H7.5V8.5H0V7.5H7.5V0H8.5V7.5Z"
            fill="black"></path>
        </g>
        <defs>
          <clipPath id="clip0_223_2">
            <rect fill="white" height="16" width="16"></rect>
          </clipPath>
        </defs>
      </svg>
    </span>
    <span class="h4 m-0 text-left"> {title}</span>
  </summary>
  <div class="max-w-prose pb-6">
    <slot />
  </div>
</details>
