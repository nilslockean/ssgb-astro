---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"details"> {
  title: string;
}

const { title, class: className, ...rest } = Astro.props;
---

<details class:list={["accordion", className]} {...rest}>
  <summary class="accordion__summary">
    <span class="accordion__icon">
      <svg
        fill="none"
        height="16"
        viewBox="0 0 16 16"
        width="16"
        xmlns="http://www.w3.org/2000/svg"
      >
        <g clip-path="url(#clip0_223_2)">
          <path
            d="M8.5 7.5H16V8.5H8.5V16H7.5V8.5H0V7.5H7.5V0H8.5V7.5Z"
            fill="black"
          />
        </g>
        <defs>
          <clipPath id="clip0_223_2">
            <rect fill="white" height="16" width="16" />
          </clipPath>
        </defs>
      </svg>
    </span>
    <span class="h4 m-0 text-left"> {title}</span>
  </summary>
  <div class="accordion__content max-w-prose">
    <slot />
  </div>
</details>

<style>
  .accordion {
    border-bottom: 1px solid var(--color-line);
  }

  .accordion:first-child {
    border-top: 1px solid var(--color-line);
  }

  .accordion__summary {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    cursor: pointer;
    padding-block: var(--space-6);
    list-style: none;
  }

  .accordion__summary::-webkit-details-marker {
    display: none;
  }

  .accordion__icon {
    transition: transform var(--default-transition-duration) var(--default-transition-timing-function);
  }

  details[open] .accordion__icon {
    transform: rotate(45deg);
  }

  .accordion__content {
    padding-bottom: var(--space-6);
  }
</style>
