---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import Section from "./Section.astro";
import ButtonLink from "./ButtonLink.astro";
import { Slug } from "@lib/routeUtils";
import { localePath } from "@lib/i18nUtils";
import { localeSchema } from "src/schemas/locale";

type Props<T extends HTMLTag = "section"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;
const locale = localeSchema.parse(Astro.currentLocale);
---

<Section class:list={["cta-contact", className]} as={as} {...rest}>
  <div class="cta-contact__inner">
    <h2 class="h3 cta-contact__title">Något du undrar över?</h2>
    <p class="intro cta-contact__subtitle">
      Hör av dig så hjälper vi dig hitta rätt upplägg.
    </p>
    <ButtonLink href={localePath(Slug.CONTACT, locale)}>Kontakta oss</ButtonLink>
  </div>
</Section>

<style>
  .cta-contact {
    padding-bottom: var(--space-16);
  }

  .cta-contact__inner {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-2xl);
    padding: var(--space-8);
  }

  .cta-contact__title {
    margin-top: 0;
    margin-bottom: var(--space-4);
  }

  .cta-contact__subtitle {
    margin-bottom: var(--space-8);
  }
</style>
