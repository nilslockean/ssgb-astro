---
import { cn } from "@lib/cn.ts";
import type { HTMLAttributes, HTMLTag } from "astro/types";
import Section from "./Section.astro";
import ButtonLink from "./ButtonLink.astro";
import { getPath, Slug } from "@config";

type Props<T extends HTMLTag = "section"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;
---

<Section {...rest} as={as} class={cn("pb-16", className)}>
  <div class="bg-brand-dark rounded-2xl p-8">
    <h2 class="h3 mt-0 mb-4">Något du undrar över?</h2>
    <p class="intro mb-8">Hör av dig så hjälper vi dig hitta rätt upplägg.</p>
    <ButtonLink href={getPath(Slug.CONTACT)}>Kontakta oss</ButtonLink>
  </div>
</Section>
