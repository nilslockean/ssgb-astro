---
import { cn } from "@lib/cn.ts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { href, class: className, ...rest } = Astro.props;
// Normalize path name (Netlify adds trailing slashes automatically)
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const isCurrentPage = href === currentPath;
---

<a
  {...rest}
  class={cn(
    "text-xl leading-tight text-muted",
    {
      underline: isCurrentPage,
    },
    className,
  )}
  data-current={isCurrentPage}
  {href}><slot /></a
>
