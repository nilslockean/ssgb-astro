---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import ButtonLink from "./ButtonLink.astro";
import { getPath } from "@config";

interface Props extends HTMLAttributes<"li"> {
  course: CollectionEntry<"courses">;
}

const {
  course: {
    data: { title, shortName, excerpt, slugId },
  },
} = Astro.props;

const href = getPath(slugId);
const cta =
  "Läs mer om " + (shortName || title).replaceAll("&shy;", "").toLowerCase();
---

<li class="course-grid-item">
  <h3 class="course-grid-item__title font-heading mt-0 normal-case">
    <a
      class="course-grid-item__link"
      href={href}
      set:html={shortName || title}
    />
  </h3>
  <p class="course-grid-item__excerpt">{excerpt}</p>
  <p class="course-grid-item__action">
    <ButtonLink href={href}>{cta}</ButtonLink>
  </p>
</li>

<style>
  .course-grid-item {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .course-grid-item__link {
    text-decoration: none;
    color: var(--color-text);
  }

  .course-grid-item__link:hover {
    text-decoration: underline;
  }

  .course-grid-item__excerpt {
    flex-grow: 1;
  }

  .course-grid-item__action {
    margin-top: var(--space-8);
  }
</style>
