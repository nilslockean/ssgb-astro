---
import type { HTMLAttributes } from "astro/types";
import ButtonLink from "./ButtonLink.astro";

interface Props extends HTMLAttributes<"li"> {
  title: string;
  excerpt: string;
  href: string;
  cta: string;
}

const { title, excerpt, href, cta, class: className, ...rest } = Astro.props;
---

<li class:list={["course-grid-item", className]} {...rest}>
  <h3 class="course-grid-item__title font-heading mt-0 normal-case">
    <a class="course-grid-item__link" href={href} set:html={title} />
  </h3>
  <p class="course-grid-item__excerpt">{excerpt}</p>
  <p class="course-grid-item__action">
    <ButtonLink href={href}>{cta}</ButtonLink>
  </p>
</li>

<style>
  .course-grid-item {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .course-grid-item__link {
    text-decoration: none;
    color: var(--color-text);
  }

  .course-grid-item__link:hover {
    text-decoration: underline;
  }

  .course-grid-item__excerpt {
    flex-grow: 1;
  }

  .course-grid-item__action {
    margin-top: var(--space-8);
  }
</style>
