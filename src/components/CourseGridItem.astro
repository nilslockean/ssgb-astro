---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import ButtonLink from "./ButtonLink.astro";
import { cn } from "@lib/cn";
import { getPath } from "@config";

interface Props extends HTMLAttributes<"li"> {
  course: CollectionEntry<"courses">;
}

const {
  course: {
    data: { title, shortName, excerpt, cta, slugId },
  },
} = Astro.props;

const href = getPath(slugId);
---

<li class={cn("bg-line rounded-xl p-8 flex flex-col justify-between")}>
  <h3 class="font-heading mt-0 normal-case">
    <a class="hover:underline" {href} set:html={shortName || title} />
  </h3>
  <p class="grow">{excerpt}</p>
  <p class="mt-8">
    <ButtonLink {href}>{cta}</ButtonLink>
  </p>
</li>
