---
import { cn } from "@lib/cn.ts";
import type { HTMLAttributes, HTMLTag } from "astro/types";
import Section from "./Section.astro";
import BookingForm from "./BookingForm.astro";

type Props<T extends HTMLTag = "section"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;
---

<Section {...rest} as={as} class={cn("mb-8", className)} id="boka">
  <div class="bg-brand-light max-w-4xl rounded-xl px-8 py-6 md:px-12 md:py-8">
    <h2 class="mt-0">Boka kurs</h2>
    <p class="intro-lg">Föreslå ett datum, så återkommer vi med bekräftelse.</p>
    <BookingForm
      maxParticipants={12}
      messagePlaceholder="Vilken kurs vill du boka?"
      name="Bokningsförfrågan"
    />
  </div>
</Section>
