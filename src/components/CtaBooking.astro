---
import type { HTMLAttributes, HTMLTag } from "astro/types";
import Section from "./Section.astro";
import BookingForm from "./BookingForm.astro";

type Props<T extends HTMLTag = "section"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;
---

<Section class:list={["cta-booking", className]} as={as} id="boka" {...rest}>
  <div class="cta-booking__inner">
    <h2 class="cta-booking__title">Boka kurs</h2>
    <p class="cta-booking__subtitle">Föreslå ett datum, så återkommer vi med bekräftelse.</p>
    <BookingForm
      maxParticipants={12}
      messagePlaceholder="Vilken kurs vill du boka?"
      name="Bokningsförfrågan"
    />
  </div>
</Section>

<style>
  .cta-booking {
    margin-bottom: var(--space-8);
  }

  .cta-booking__inner {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
    border: 1px solid var(--color-surface-dark);
  }

  @media (--breakpoint-md) {
    .cta-booking__inner {
      padding: var(--space-8) var(--space-12);
    }
  }

  .cta-booking__title {
    margin-top: 0;
  }

  .cta-booking__subtitle {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    max-width: var(--prose);
  }
</style>
