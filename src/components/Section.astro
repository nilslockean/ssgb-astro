---
import type { HTMLAttributes, HTMLTag } from "astro/types";

type Props<T extends HTMLTag = "section"> = HTMLAttributes<T> & {
  as?: T;
};

const { as, class: className, ...rest } = Astro.props;

const Tag: HTMLTag = as || "section";
---

<Tag class:list={["section", className]} {...rest}>
  <slot />
</Tag>

<style>
  .section {
    background-color: var(--color-brand);
    padding: var(--space-8);
  }

  .section.pb-16 {
    padding-bottom: var(--space-16);
  }

  .section.pb-0 {
    padding-bottom: 0;
  }
</style>
