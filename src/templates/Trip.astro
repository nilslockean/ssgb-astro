---
import type { CollectionEntry } from "astro:content";
import StructuredText from "@features/dato/StructuredText.astro";
import Hero, { type HeroButton } from "@components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import Section from "@components/Section.astro";
import Pill from "@components/Pill.astro";
import { composePath } from "@lib/routeUtils";
import { defaultLocale } from "@lib/routeUtils";
import { localeSchema } from "../schemas/locale";

interface Props {
  data: CollectionEntry<"trips">["data"];
}

const CONTACT_SLUG: Record<string, string> = {
  sv: "kontakt",
  en: "contact",
  da: "kontakt",
};

const {
  data: {
    title,
    excerpt,
    cta,
    slug,
    heroImage,
    heroImageData,
    body,
    seo,
    location,
  },
} = Astro.props;

const locale = localeSchema.catch(defaultLocale).parse(Astro.currentLocale);
const heroButtons: HeroButton[] = [
  { label: cta, href: composePath(CONTACT_SLUG[locale], locale) },
];
---

<Layout seoData={seo}>
  <script
    is:inline
    slot="head"
    define:vars={{ tripTitle: title, tripSlug: slug, tripLocale: locale }}
  >
    window.posthog?.capture("trip_viewed", {
      trip_title: tripTitle,
      trip_slug: tripSlug,
      locale: tripLocale,
    });
  </script>
  <Hero
    buttons={heroButtons}
    content={excerpt}
    image={heroImage}
    data={heroImageData}
    title={title}
  >
    {
      location && (
        <Pill slot="metadata" icon="location" label={location.title} />
      )
    }
  </Hero>
  <Section>
    <div class="collection-entry">
      {body && <StructuredText data={body} />}
    </div>
  </Section>
</Layout>
