---
import { getLocalizedConfig } from "@lib/contentUtils";
import { composePath } from "@lib/routeUtils";
import type { HTMLAttributes } from "astro/types";
import { localeSchema } from "src/schemas/locale";

interface Props extends HTMLAttributes<"a"> {
  height?: number;
}

const { height = 64 } = Astro.props;
const currentLocale = localeSchema.parse(Astro.currentLocale);
const config = await getLocalizedConfig(currentLocale);
const logo = config.logo;
---

<a class="logo" href={composePath("", currentLocale)}>
  {logo ? (
    <img
      alt={logo.alt ?? config.siteTitle}
      height={height}
      src={logo.src}
      style={{ width: "auto" }}
      width={logo.width}
    />
  ) : (
    config.siteTitle
  )}
</a>

<style>
  .logo {
    display: flex;
  }
</style>
