---
import type { HTMLAttributes } from "astro/types";
import AstroNavLink from "@components/NavLink.astro";
import type { NavLink } from "@lib/routeUtils";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props extends HTMLAttributes<"li"> {
  entry: NavLink;
}

const { entry } = Astro.props;
---

<li>
  <AstroNavLink
    class:list={["nav-link--sm"]}
    href={getRelativeLocaleUrl(entry.locale, entry.path)}
    set:html={entry.label}
  />
</li>
