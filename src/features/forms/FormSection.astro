---
import Section from "@components/Section.astro";
import type { CollectionEntry } from "astro:content";
import FormInputText from "./FormInputText.astro";
import FormInputTextarea from "./FormInputTextarea.astro";
import FormInputDate from "./FormInputDate.astro";
import FormInputNumber from "./FormInputNumber.astro";
import FormOptions from "./FormOptions.astro";
import { composePath } from "@lib/routeUtils";
import { localeSchema } from "../../schemas/locale";
import { z } from "astro/zod";

const jsonSchema = z.json();
type JSONType = z.infer<typeof jsonSchema>;

interface Props {
  form: CollectionEntry<"forms">;
  id?: string;
  title?: string;
  preselectedFields?: JSONType | null;
}
const {
  form: { data },
  id,
  title = data.title,
  preselectedFields,
} = Astro.props;
console.log("Form", { data, title, id });
const currentLocale = localeSchema.parse(Astro.currentLocale);
const action = composePath(data.redirect || "", currentLocale);
function getDefaultValue(fieldName: string): string | null {
  const preselectedFieldsSchema = z.record(z.string(), z.string());
  const result = preselectedFieldsSchema.safeParse(preselectedFields);
  if (!result.success) {
    return null;
  }

  const defaultValues = result.data;
  return defaultValues[fieldName] ?? null;
}
---

<Section {id} class="mt-8">
  <div class="contact-form-card">
    <h2 class="mt-2">{title}</h2>

    {
      data.description && (
        <div class="contact-form__description" set:html={data.description} />
      )
    }

    <form
      action={action}
      class="contact-form"
      data-netlify="true"
      method="POST"
      name={title}
      netlify-honeypot="bot-field"
    >
      <p class="hidden">
        <label>
          Don't touch this field: <input name="bot-field" />
        </label>
      </p>

      <div class="contact-form__grid">
        {
          data.content.map((field) => {
            const defaultValue = getDefaultValue(field.name);
            return (
              <p
                class:list={[
                  {
                    "contact-form__message":
                      field.__typename === "FormInputTextareaRecord",
                  },
                ]}
              >
                {field.__typename === "FormInputTextareaRecord" && (
                  <FormInputTextarea {...field} />
                )}
                {field.__typename === "FormInputTextRecord" && (
                  <FormInputText {...field} />
                )}
                {field.__typename === "FormInputDateRecord" && (
                  <FormInputDate {...field} />
                )}
                {field.__typename === "FormInputNumberRecord" && (
                  <FormInputNumber {...field} />
                )}
                {field.__typename === "FormInputOptionRecord" && (
                  <FormOptions {...field} {defaultValue} />
                )}
              </p>
            );
          })
        }
      </div>

      <p class="contact-form__submit">
        <button class="btn btn--primary" type="submit">{data.cta}</button>
      </p>
    </form>
  </div>
</Section>
<style>
  @import "../../styles/breakpoints.css";

  .contact-form-card {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
  }

  @media (--breakpoint-md) {
    .contact-form-card {
      padding: var(--space-8) var(--space-12);
    }
  }

  .contact-form {
    margin-top: var(--space-8);
  }

  .contact-form__description {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    max-width: var(--prose);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (--breakpoint-lg) {
    .contact-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-form__message {
    grid-column: 1 / -1;
  }

  .contact-form__submit {
    margin-top: var(--space-4);
    text-align: right;
  }
</style>
