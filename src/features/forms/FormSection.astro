---
import Section from "@components/Section.astro";
import type { CollectionEntry } from "astro:content";
import FormInputText from "./FormInputText.astro";
import FormInputTextarea from "./FormInputTextarea.astro";
import FormInputDate from "./FormInputDate.astro";
import FormInputNumber from "./FormInputNumber.astro";
import FormOptions from "./FormOptions.astro";
import FormCourseOptions from "./FormCourseOptions.astro";
import FormInputCheckbox from "./FormInputCheckbox.astro";
import { composePath } from "@lib/routeUtils";
import { localeSchema } from "../../schemas/locale";
import StructuredText from "@features/dato/StructuredText.astro";
import FormOrderTotal from "./FormOrderTotal.svelte";

interface Props {
  form: CollectionEntry<"forms">;
  id?: string;
  title?: string;
  priceSingle?: number;
  priceDouble?: number;
  priceMany?: number;
  maxParticipants?: number;
  numDays?: number;
}
const {
  form: { data },
  id,
  title = data.title,
  priceSingle,
  priceDouble,
  priceMany,
  maxParticipants,
  numDays,
} = Astro.props;
const currentLocale = localeSchema.parse(Astro.currentLocale);
const currentSlug = Astro.url.pathname
  .split("/")
  .filter((x) => x)
  .pop();
const action = composePath(data.redirect, currentLocale);
---

<script>
  document
    .querySelectorAll<HTMLFormElement>("form.contact-form")
    .forEach((form) => {
      form.addEventListener("submit", () => {
        (window as any).posthog?.capture("booking_form_submitted", {
          form_name: form.name,
        });
      });
    });

  document.addEventListener("DOMContentLoaded", () => {
    const numParticipantsInputField = document.querySelector<HTMLInputElement>(
      "input[type=number][name=numParticipants]",
    );
    if (!numParticipantsInputField) {
      return;
    }

    window.addEventListener("num_participants_updated", (evt) => {
      if ("detail" in evt === false || typeof evt.detail !== "number") {
        return;
      }
      numParticipantsInputField.value = String(evt.detail);
      numParticipantsInputField.dispatchEvent(new Event("input"));
    });
  });
</script>

<Section id={id || data.id} class="mt-8">
  <div class="contact-form-card">
    <h2 class="mt-2">{title}</h2>

    {
      data.description && (
        <div class="contact-form__description" set:html={data.description} />
      )
    }

    <form
      action={action}
      class="contact-form"
      data-netlify="true"
      method="POST"
      name={title}
      netlify-honeypot="bot-field"
    >
      <p class="hidden">
        <label>
          Don't touch this field: <input name="bot-field" />
        </label>
      </p>

      <div class="contact-form__grid">
        {
          data.content.map((field) => {
            return (
              <p
                class:list={[
                  {
                    "contact-form__message":
                      field.__typename === "FormInputTextareaRecord",
                  },
                ]}
              >
                {field.__typename === "FormInputTextareaRecord" && (
                  <FormInputTextarea {...field} />
                )}
                {field.__typename === "FormInputTextRecord" && (
                  <FormInputText {...field} />
                )}
                {field.__typename === "FormInputDateRecord" && (
                  <FormInputDate {...field} />
                )}
                {field.__typename === "FormInputNumberRecord" && (
                  <FormInputNumber
                    {...field}
                    max={
                      field.name === "numParticipants" &&
                      maxParticipants != null
                        ? maxParticipants
                        : field.max
                    }
                  />
                )}
                {field.__typename === "FormInputOptionRecord" && (
                  <FormOptions {...field} />
                )}
                {field.__typename === "FormInputCoursesOptionRecord" && (
                  <FormCourseOptions
                    {...field}
                    defaultValue={currentSlug || null}
                  />
                )}
                {field.__typename === "FormInputCheckboxRecord" && (
                  <FormInputCheckbox
                    id={field.id}
                    label={field.label}
                    name={field.name}
                    required={field.required}
                  />
                )}
                {field.__typename === "FormOrderTotalRecord" &&
                  priceSingle != null && (
                    <FormOrderTotal
                      client:load
                      {priceSingle}
                      {priceDouble}
                      {priceMany}
                      {maxParticipants}
                      {numDays}
                      locale={currentLocale}
                    />
                  )}
              </p>
            );
          })
        }
      </div>

      {
        data.subtext && (
          <div class="contact-form__subtext">
            <StructuredText data={data.subtext} />
          </div>
        )
      }

      <p class="contact-form__submit">
        <button class="btn btn--primary" type="submit">{data.cta}</button>
      </p>
    </form>
  </div>
</Section>
<style>
  @import "../../styles/breakpoints.css";

  .contact-form-card {
    background-color: var(--color-surface-light);
    border-radius: var(--border-radius-xl);
    padding: var(--space-6) var(--space-8);
    max-width: 56rem;
  }

  @media (--breakpoint-md) {
    .contact-form-card {
      padding: var(--space-8) var(--space-12);
    }
  }

  .contact-form {
    margin-top: var(--space-8);
  }

  .contact-form__description {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    max-width: var(--prose);
  }

  .contact-form__grid {
    display: grid;
    gap: var(--space-8);
  }

  .contact-form__subtext {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
  }

  @media (--breakpoint-lg) {
    .contact-form__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .contact-form__message {
    grid-column: 1 / -1;
  }

  .contact-form__submit {
    margin-top: var(--space-4);
    text-align: right;
  }
</style>
