---
export interface Props {
  id: string;
  label: string;
  name: string;
  required?: boolean | null;
  placeholder?: string | null;
}

const { id, label, name, required, placeholder } = Astro.props;
---

<label>
  {label}{required && "*"}
  <br />
  <textarea {id} {name} {required} {placeholder}></textarea>
</label>
