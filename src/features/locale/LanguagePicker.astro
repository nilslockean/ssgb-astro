---
import { LOCALES, languages } from "@lib/i18nUtils";
import { localeSchema } from "src/schemas/locale";
import LocaleFlag from "@components/flags/LocaleFlag.astro";
import { getLocalizedUrls } from "@lib/routeUtils";

const currentLocale = localeSchema.parse(Astro.currentLocale);
const localizedUrls = await getLocalizedUrls(Astro.url);
---

<ul>
  {
    languages.map((lang) => (
      <li>
        <a href={localizedUrls[lang]} data-current={lang === currentLocale}>
          <LocaleFlag locale={lang} size={24} />
          <span class="sr-only">{LOCALES[lang]}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    gap: var(--space-2);
  }
  a {
    display: flex;
    border-radius: 50%;
  }
  a[data-current="true"] {
    outline: 2px solid var(--color-white);
  }
</style>
