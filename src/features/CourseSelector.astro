---
import Accordion from "@components/Accordion.astro";
import Link from "@components/Link.astro";
import Section from "@components/Section.astro";
import { Slug } from "@lib/routeUtils";

interface Segment {
  text: string;
  slug?: Slug;
}

interface CourseSection {
  title: string;
  body: Segment[][];
}

const sections: CourseSection[] = [
  {
    title: "Helt ny ute?",
    body: [
      [
        { text: "Om du aldrig har klättrat förut, välj prova på eller " },
        { text: "topprepskurs", slug: Slug.COURSE_TOPROPE },
        { text: "." },
      ],
      [
        {
          text: "Om du redan kan säkra en klättrare på topprep är det ",
        },
        { text: "grundkursen", slug: Slug.COURSE_TOPROPE },
        {
          text: " du ska gå. Där får du lära dig att lägga säkringar, bygga topprepsankare och fira.",
        },
      ],
      [
        {
          text: "Om du kan ledsäkra och vet med dig att du vill hålla dig till bultade leder så är ",
        },
        { text: "sportklätterkursen", slug: Slug.COURSE_SPORT },
        {
          text: " ett bra alternativ.",
        },
      ],
    ],
  },
  {
    title: "Redo att börja leda?",
    body: [
      [
        { text: "Har du redan gått grundkurs klippa är det helt klart " },
        { text: "fortsättningskursen", slug: Slug.COURSE_CRAG_ADV },
        {
          text: " du ska gå. Här får du bland annat lära dig leda på egenplacerade säkringar, bygga standplats och säkra upp en andreman.",
        },
      ],
      [
        { text: "Om du hellre vill hålla dig till bultade leder kan du gå en " },
        { text: "sportklätterkurs", slug: Slug.COURSE_SPORT },
        { text: "." },
      ],
    ],
  },
  {
    title: "Redan igång med sportklättring?",
    body: [
      [
        { text: "Under " },
        { text: "tradkursen", slug: Slug.COURSE_TRAD },
        {
          text: " får du lära dig leda på egenplacerade säkringar, bygga standplats och i mån av tid klättra multipitch.",
        },
      ],
    ],
  },
  {
    title: "Vad gör du när något går fel?",
    body: [
      [
        {
          text: "Kamraträddningskurserna ger dig metoder för att hantera incidenter som kan uppstå på klippan.",
        },
      ],
      [
        { text: "Lär dig hjälpa en andreman i nöd på " },
        { text: "Räddningskurs 1", slug: Slug.COURSE_RESCUE_BASIC },
        {
          text: " och ta metoderna vidare till att rädda en utsatt försteman under ",
        },
        { text: "Räddningskurs 2", slug: Slug.COURSE_RESCUE_ADV },
        { text: "." },
      ],
    ],
  },
];
---

<Section>
  <h2 class="mb-4">Vilken kurs passar dig?</h2>
  {
    sections.map((section) => (
      <Accordion title={section.title}>
        {section.body.map((paragraph) => (
          <p>
            {paragraph.map((segment) =>
              segment.slug ? (
                <Link slug={segment.slug}>{segment.text}</Link>
              ) : (
                segment.text
              ),
            )}
          </p>
        ))}
      </Accordion>
    ))
  }
</Section>
