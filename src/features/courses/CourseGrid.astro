---
import type { CollectionEntry } from "astro:content";
import type { HTMLAttributes } from "astro/types";
import CourseGridItem from "./CourseGridItem.astro";
import { courseUrl, defaultLocale, tripUrl } from "@lib/routeUtils";
import { localeSchema } from "src/schemas/locale";

interface Props extends HTMLAttributes<"ul"> {
  entries: CollectionEntry<"courses">[] | CollectionEntry<"trips">[];
}

function isCourse(
  entry: CollectionEntry<"courses"> | CollectionEntry<"trips">,
): entry is CollectionEntry<"courses"> {
  return "numDays" in entry.data;
}

function composeCta(title: string, locale = defaultLocale) {
  title = title.replaceAll("&shy;", "").toLowerCase();
  const prefix =
    locale === "da"
      ? "Læs mere om"
      : locale === "en"
        ? "Read more about"
        : "Läs mer om";
  return `${prefix} ${title}`;
}

const { entries, class: className, ...rest } = Astro.props;
const locale = localeSchema.parse(Astro.currentLocale);
---

<ul
  class:list={[
    "course-grid",
    "grid-cols-1",
    "lg:grid-cols-2",
    "xl:grid-cols-3",
    className,
  ]}
  {...rest}
>
  {
    entries.map((course) => {
      const title = course.data.title;
      const href = isCourse(course)
        ? courseUrl(course.data.slug, locale)
        : tripUrl(course.data.slug, locale);
      const cta = composeCta(title, locale);

      return (
        <CourseGridItem
          cta={cta}
          excerpt={course.data.excerpt}
          href={href}
          title={title}
          displayLink={course.data.hasPage}
        />
      );
    })
  }
  <slot />
</ul>

<style>
  .course-grid {
    display: grid;
    gap: var(--space-8);
    margin-bottom: var(--space-12);
    margin-top: var(--space-8);
  }
</style>
