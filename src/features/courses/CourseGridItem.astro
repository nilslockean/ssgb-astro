---
import Card from "@components/Card.astro";
import ButtonLink from "@components/ButtonLink.astro";
import type { DatoImage } from "../../schemas/dato";

interface Props {
  title: string;
  excerpt: string;
  href: string;
  cta: string;
  displayLink?: boolean;
  heroImage?: DatoImage;
}

const {
  title,
  excerpt,
  href,
  cta,
  displayLink = true,
  heroImage,
} = Astro.props;
---

<Card
  as="article"
  headingLevel="h3"
  title={title}
  href={displayLink ? href : undefined}
  image={heroImage
    ? { src: heroImage.src, alt: heroImage.alt ?? undefined }
    : undefined}
>
  <p class="course-grid-item__excerpt">{excerpt}</p>
  {
    displayLink && (
      <ButtonLink href={href} slot="actions">
        {cta}
      </ButtonLink>
    )
  }
</Card>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>(".course-grid .card__link")
    .forEach((link) => {
      link.addEventListener("click", () => {
        (window as any).posthog?.capture("course_card_clicked", {
          course_title: link.textContent?.trim(),
          href: link.getAttribute("href"),
        });
      });
    });
</script>

<style>
  .course-grid-item__excerpt {
    flex-grow: 1;
  }
</style>
