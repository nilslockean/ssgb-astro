---
import { StructuredText as LibStructuredText } from "@datocms/astro";
import type { CdaStructuredTextValue } from "@datocms/astro/StructuredText";
import ButtonBlock from "@features/dato/ButtonBlock.astro";
import ButtonGroupBlock from "@features/dato/ButtonGroupBlock.astro";
import CourseCollectionBlock from "@features/dato/CourseCollectionBlock.astro";
import PageInternalLink from "@features/dato/PageInternalLink.astro";
import ContactDetailInline from "@features/dato/ContactDetailInline.astro";
import PriceDetailInline from "@features/dato/PriceDetailInline.astro";
import AccordionBlock from "@features/dato/AccordionBlock.astro";
import TeamCollectionBlock from "@features/dato/TeamCollectionBlock.astro";

export interface Props {
  data: CdaStructuredTextValue;
}

const { data } = Astro.props;
---

<LibStructuredText
  data={data}
  blockComponents={{
    ButtonRecord: ButtonBlock,
    ButtonGroupRecord: ButtonGroupBlock,
    CourseCollectionRecord: CourseCollectionBlock,
    AccordionRecord: AccordionBlock,
    TeamCollectionRecord: TeamCollectionBlock,
  }}
  inlineBlockComponents={{
    ContactDetailRecord: ContactDetailInline,
    PriceDetailRecord: PriceDetailInline,
  }}
  linkToRecordComponents={{
    CourseRecord: PageInternalLink,
    PageRecord: PageInternalLink,
    TripRecord: PageInternalLink,
  }}
/>
