---
import CourseGrid from "@features/courses/CourseGrid.astro";
import { getCourses } from "@lib/contentUtils";
import { localeSchema } from "../../schemas/locale";
import Eyebrow from "@components/Eyebrow.astro";

interface Props {
  block: {
    filter: "all" | "with-norms" | "without-norms";
    eyebrow?: string | null;
    limit?: number | null;
  };
}

const {
  block: { filter, eyebrow, limit },
} = Astro.props;

const locale = localeSchema.parse(Astro.currentLocale);
let entries = await getCourses((course) => {
  switch (filter) {
    case "with-norms":
      return course.data.norm;
    case "without-norms":
      return !course.data.norm;
    default:
      return true;
  }
}, locale);

if (limit) {
  entries = entries.slice(0, limit);
}
---

{eyebrow && <Eyebrow class="course-collection__eyebrow">{eyebrow}</Eyebrow>}
<CourseGrid entries={entries} />

<style>
  .course-collection__eyebrow {
    margin-top: var(--space-12);
  }
</style>
