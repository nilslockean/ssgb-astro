---
import type { CdaStructuredTextValue } from "@datocms/astro/StructuredText";
import StructuredText from "./StructuredText.astro";
import Accordion from "@components/Accordion.astro";

interface Props {
  block: {
    details: Array<{
      summary: string;
      structuredText: CdaStructuredTextValue;
    }>;
  };
}

const { block } = Astro.props;
---

<div>
  {
    block.details.map((detail) => (
      <Accordion title={detail.summary}>
        <StructuredText data={detail.structuredText} />
      </Accordion>
    ))
  }
</div>

<style>
  div {
    padding-top: var(--space-8);
  }
</style>
