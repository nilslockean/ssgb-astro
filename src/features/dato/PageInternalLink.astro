---
import { courseUrl, tripUrl, composePath, type Locale } from "@lib/routeUtils";

interface Props {
  record: { __typename: string; id: string; slug: string };
  attrs: Record<string, string>;
}

const { record, attrs } = Astro.props;
const locale = (Astro.currentLocale ?? "sv") as Locale;

let href: string;
switch (record.__typename) {
  case "CourseRecord":
    href = courseUrl(record.slug, locale);
    break;
  case "TripRecord":
    href = tripUrl(record.slug, locale);
    break;
  default:
    href = composePath(record.slug, locale);
}
---

<a href={href} {...attrs}><slot /></a>
