---
import { Image } from "astro:assets";
import { getLocalizedConfig } from "@lib/contentUtils";
import Section from "@components/Section.astro";

const config = await getLocalizedConfig(Astro.currentLocale);
const { title, content, image } = config.authorizedInstructor;
---

<Section>
  <div class="card">
    <Image
      src={{
        src: image.url,
        width: image.width,
        height: image.height,
        format: "webp",
      }}
      alt={image.alt}
    />
    <div class="card__inner">
      <h2 class="h3">{title}</h2>
      <p>{content}</p>
    </div>
  </div>
</Section>

<style>
  .card {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-6);
  }

  .card__inner {
    max-width: var(--prose);
  }

  .card img {
    width: 160px;
    height: fit-content;
  }

  .h3 {
    margin-top: 0;
    line-height: 2.3rem;
  }
</style>
